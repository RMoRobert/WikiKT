# WikiKT home deployment: copy to `.env` next to docker-compose.home.yml, fill in, chmod 600 .env.
# Used by: docker compose -f docker-compose.home.yml up -d --build
#
# Not a closed list: the compose file passes this whole file to the app, so any WIKIKT_* setting from
# the reference table in docs/install.md can be added here. Settings the compose file pins itself
# (production mode, the proxy/cookie posture, the database wiring) override this file by design.
# Note there is no WIKIKT_DOMAIN / WIKIKT_EXTRA_DOMAINS here -- those configure the bundled Caddy in
# the production stack, and this stack has no Caddy (your own proxy handles certs and hostnames).
#
# QUOTING: single-quote any value you type by hand that may contain a "$", e.g.
#   WIKIKT_ADMIN_PASSWORD='my p@$$word'
# Unquoted, Compose reads "$word" as a variable reference and silently drops it (a$bcdef becomes just
# "a"). Generated hex/base64 values never contain "$", so they need no quoting.


# PostgreSQL password: used by both the postgres container and the app.
# Generate a random strong password:  openssl rand -hex 24
# (Not needed if you switched the compose file to H2; see the H2 ALTERNATIVE notes there.)
POSTGRES_PASSWORD=

# Session cookie keys, hex format, both required in prod mode. Generate with:
#   echo "WIKIKT_SESSION_ENCRYPTION_KEY=$(openssl rand -hex 16)"
#   echo "WIKIKT_SESSION_SIGN_KEY=$(openssl rand -hex 32)"
WIKIKT_SESSION_ENCRYPTION_KEY=
WIKIKT_SESSION_SIGN_KEY=

# MFA key, hex format, encrypts stored two-factor (TOTP) secrets at rest; also required for prod miode.
# Generate with:  echo "WIKIKT_MFA_KEY=$(openssl rand -hex 32)"
WIKIKT_MFA_KEY=

# Initial `admin` account password (the built-in fallback of "changeme" will fail in prod mode).
WIKIKT_ADMIN_PASSWORD=

# Canonical public URL: the address your reverse proxy serves WikiKT at. Used for links in
# outbound email (password reset, welcome), so they point at your real host.
#   Production/TLS (default):  https://wiki.home.lan
#   Plain-HTTP/dev variant:    http://192.168.1.50:8080
WIKIKT_PUBLIC_URL=https://wiki.example.com

# --- Asset delivery (optional) ------------------------------------------------------------------
# Front-end libraries and webfonts load from public CDNs by default. Each is also bundled in the
# image, so you can serve it from your own box instead -- useful on a LAN with no internet access,
# or to keep visitor IPs off jsDelivr/Google. Uncomment ALL THREE for no outbound requests.
# See docs/install.md ("Asset delivery"); current state shows in Admin > Settings > Appearance.
# WIKIKT_UI_ASSET_SOURCE=local        # Bootstrap, highlight.js (~440KB)
# WIKIKT_UI_ICON_FONT_SOURCE=local    # Material Design Icons (~750KB) -- blocked CDN = missing icons
# WIKIKT_UI_EMOJI_FONT_SOURCE=local   # Noto Color Emoji (~2MB) -- blocked CDN = OS emoji instead
#
# Note: the body/heading font picked in Admin > Settings > Appearance still loads from Google Fonts.
# Choose the "System UI" preset there to drop that request as well.
