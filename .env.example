# Production Docker environment: copy to .env and fill in before running docker-compose.prod.yml.
# See docker/README.md for details. Keep the real .env out of version control (it holds secrets).

# Primary domain for HTTPS (required): Caddy obtains and renews the Let's Encrypt certificate for primary domain.
# Also used to build WIKIKT_PUBLIC_URL (the host in outbound email links).
WIKIKT_DOMAIN=wiki.example.com

# Extra site hostnames (optional, space-separated) for WikiKT's multi-site feature. Caddy obtains a
# cert for and routes each one to WikiKT. A new site hostname must be added both here (re-deploy if already
# deployed, e.g., docker compose -f docker-compose.prod.yml up -d) **and** in Admin > Sites, and be sure to
# configure your DNS to point to the Caddy server as well.
# WIKIKT_EXTRA_DOMAINS=docs.example.com team.example.com

# PostgreSQL password (also used by the app to connect).
POSTGRES_PASSWORD=change-me-strong-password

# Session keys -- HEX strings, both required in production mode.
# Generate: openssl rand -hex 16   (encryption)
#           openssl rand -hex 32   (sign)
WIKIKT_SESSION_ENCRYPTION_KEY=
WIKIKT_SESSION_SIGN_KEY=

# MFA key — HEX, encrypts stored two-factor (TOTP) secrets at rest; also required in production.
# Generate similar to above: openssl rand -hex 32
WIKIKT_MFA_KEY=

# Admin user password (fallback of "changeme" will refuse to start in production).
WIKIKT_ADMIN_PASSWORD=

# Canonical public URL for links in outbound email (password reset, welcome). Optional: the compose
# file derives it from WIKIKT_DOMAIN (https://$WIKIKT_DOMAIN). Uncomment only to override -- e.g. a
# non-standard port or a path prefix.
# WIKIKT_PUBLIC_URL=https://wiki.example.com

# --- Asset delivery ---------------------------------------------------------------------------
# Front-end libraries and webfonts load from public CDNs by default. Each is also bundled in the
# image, so you can serve it yourself instead -- for an air-gapped network, a strict egress policy,
# or to avoid sending visitor IPs to a third party. Uncomment ALL THREE for no outbound requests.
# See docs/install.md ("Asset delivery"); current state is shown in Admin > Settings > Appearance.
# WIKIKT_UI_ASSET_SOURCE=local        # Bootstrap, highlight.js (~440KB)
# WIKIKT_UI_ICON_FONT_SOURCE=local    # Material Design Icons (~750KB) -- blocked CDN = missing icons
# WIKIKT_UI_EMOJI_FONT_SOURCE=local   # Noto Color Emoji (~2MB) -- blocked CDN = OS emoji instead
#
# Note: the body/heading font picked in Admin > Settings > Appearance still loads from Google Fonts.
# Choose the "System UI" preset there to drop that request as well.

