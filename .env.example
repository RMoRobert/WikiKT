# Production Docker environment: copy to .env and fill in before running docker-compose.prod.yml.
# See docker/README.md for details. Keep the real .env out of version control (it holds secrets).
#
# The variables below are the ones most deployments need, but this is not a closed list: the compose
# file passes this whole file to the app, so any WIKIKT_* setting from the reference table in
# docs/install.md can be added here. Settings the compose file pins itself (production mode, the
# proxy/cookie posture, the database wiring) intentionally override this file -- edit the compose file
# to change those.
#
# QUOTING: single-quote any value you type by hand that may contain a "$", e.g.
#   WIKIKT_ADMIN_PASSWORD='my p@$$word'
# Unquoted, Compose reads "$word" as a variable reference and silently drops it (a$bcdef becomes just
# "a"). Generated hex/base64 values never contain "$", so they need no quoting.


# --- Caddy (these two configure the proxy, NOT WikiKT itself) -----------------------------------
# Primary domain for HTTPS (required): Caddy obtains and renews the Let's Encrypt certificate for primary domain.
# Also used to build WIKIKT_PUBLIC_URL (the host in outbound email links).
WIKIKT_DOMAIN=wiki.example.com

# Extra site hostnames (optional, space-separated; quotes around the value optional) for WikiKT's multi-site feature.
# Caddy obtains a cert for and routes each one to WikiKT -- it does NOT create the sites. A new site
# hostname must be added both here (re-deploy if already deployed, e.g., docker compose
# -f docker-compose.prod.yml up -d) *and* in **Admin > Sites** in WikiKT itself. Also, be sure to configure your DNS
# to point to your Caddy server as well.
# WIKIKT_EXTRA_DOMAINS=docs.example.com team.example.com

# PostgreSQL password (also used by the app to connect).
POSTGRES_PASSWORD=change-me-strong-password

# Session keys -- HEX strings, both required in production mode.
# Generate: openssl rand -hex 16   (encryption)
#           openssl rand -hex 32   (sign)
WIKIKT_SESSION_ENCRYPTION_KEY=
WIKIKT_SESSION_SIGN_KEY=

# MFA key — HEX, encrypts stored two-factor (TOTP) secrets at rest; also required in production.
# Generate similar to above: openssl rand -hex 32
WIKIKT_MFA_KEY=

# Admin user password (fallback of "changeme" will refuse to start in production).
WIKIKT_ADMIN_PASSWORD=

# Canonical public URL for links in outbound email (password reset, welcome). Optional: defaults to
# https://$WIKIKT_DOMAIN. Uncomment to override -- e.g. a non-standard port or a path prefix.
# WIKIKT_PUBLIC_URL=https://wiki.example.com

# --- Asset delivery ---------------------------------------------------------------------------
# Front-end libraries and webfonts load from public CDNs by default. Each is also bundled in the
# image, so you can serve it yourself instead -- for an air-gapped network, a strict egress policy,
# or to avoid sending visitor IPs to a third party. Uncomment ALL THREE for no outbound requests.
# See docs/install.md ("Asset delivery"); current state is shown in Admin > Appearance.
# WIKIKT_UI_ASSET_SOURCE=local        # Bootstrap, highlight.js (~440KB)
# WIKIKT_UI_ICON_FONT_SOURCE=local    # Material Design Icons (~750KB) -- blocked CDN = missing icons
# WIKIKT_UI_EMOJI_FONT_SOURCE=local   # Noto Color Emoji (~2MB) -- blocked CDN = OS emoji instead
#
# Note: the body/heading font picked in **Admin > Appearance** still loads from Google Fonts.
# Choose the "System UI" preset or custom value with common client fonts or font family for local option.


# --- One-click updates ------------------------------------------------------------------------
# The line below enables the wikikt-updater sidecar by default for this stack: it powers the
# **Install update** button in Administration > Updates (handles pre-update database dump, health check on the
# new version, automatic rollback). It holds the Docker socket (root-equivalent on the host, but only
# the sidecar and not the wikikt app container itself). Read "One-click updates" in docker/README.md for
# more about the trust model.
# *PREFER AN OFFLINE/NO-SOCKET DEPLOYMENT?* Comment the line out (nothing else changes; the
# Updates page can still check for current version and show manual upgrade instructions, requiring
# host access for user to perform).
COMPOSE_PROFILES=selfupdate

# Only needed with the updater when the project is *not* at `/opt/wikikt` (the install location
# docs/install.md recommends, and the default): the absolute host path of the directory holding
# docker-compose.prod.yml. The updater mounts the project at this same path so `docker compose`
# inside it resolves bind mounts correctly.
# WIKIKT_COMPOSE_DIR=/opt/wikikt
