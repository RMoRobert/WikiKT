<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Navigation | Admin</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/admin-shell.hbs}}
    <div class="page-meta"><h1><i class="mdi mdi-ship-wheel" aria-hidden="true"></i> Navigation</h1></div>
    {{#otherSite}}<div class="alert alert-warning" role="alert"><i class="mdi mdi-information-outline" aria-hidden="true"></i> That menu belongs to a different site. Showing <strong>{{managedSiteName}}</strong>'s menus instead.</div>{{/otherSite}}
    {{#modeSaved}}<div class="alert alert-success" role="alert"><i class="mdi mdi-check-circle-outline" aria-hidden="true"></i> Navigation settings saved.</div>{{/modeSaved}}

    {{! Navigation mode: which sidebar(s) the wiki offers visitors. }}
    <form method="post" action="/a/navigation/mode" class="card mb-4" style="max-width: 46rem;">
        {{{csrfField}}}
        <div class="card-body">
            <h2 class="h5 mb-1">Sidebar navigation</h2>
            <p class="text-secondary">Choose how visitors navigate between pages from the sidebar.</p>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="mode" id="modeStatic" value="static"{{#modeStatic}} checked{{/modeStatic}}>
                <label class="form-check-label" for="modeStatic">
                    <strong>Static menu only</strong>
                    <span class="d-block text-secondary small">A fixed sidebar you curate below. This is the default.</span>
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="mode" id="modeTree" value="tree"{{#modeTree}} checked{{/modeTree}}>
                <label class="form-check-label" for="modeTree">
                    <strong>Site tree only</strong>
                    <span class="d-block text-secondary small">An automatic, browsable folder tree of your pages. No menu to maintain.</span>
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="mode" id="modeBoth" value="both"{{#modeBoth}} checked{{/modeBoth}}>
                <label class="form-check-label" for="modeBoth">
                    <strong>Site tree + static menu</strong>
                    <span class="d-block text-secondary small">Both, with a switch in the sidebar. Each visitor's choice is remembered in their browser.</span>
                </label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="mode" id="modeNone" value="none"{{#modeNone}} checked{{/modeNone}}>
                <label class="form-check-label" for="modeNone">
                    <strong>None</strong>
                    <span class="d-block text-secondary small">No sidebar. Visitors navigate via links, breadcrumbs, and search.</span>
                </label>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>

    {{! Static menu editor — only meaningful when a static menu is shown, but always editable so a menu can
        be prepared before switching modes. }}
    <div class="page-meta"><h2 class="h5"><i class="mdi mdi-format-list-bulleted" aria-hidden="true"></i> Static menus</h2><a class="btn btn-primary" href="/a/navigation/new">New menu</a></div>
    {{^staticEnabled}}<p class="text-secondary"><i class="mdi mdi-information-outline" aria-hidden="true"></i> The current mode doesn't show a static menu, so these menus aren't displayed to visitors right now.</p>{{/staticEnabled}}
    <p class="text-secondary">Each menu is a sidebar. The default menu (empty scope) is used everywhere a more specific menu doesn't match.</p>
    <table class="table table-hover align-middle">
        <thead><tr><th>Scope</th><th>Items</th><th></th></tr></thead>
        <tbody>
        {{#menus}}
        <tr>
            <td>{{#isDefault}}<em>Default (all pages)</em>{{/isDefault}}{{^isDefault}}<code>{{scope}}</code>{{/isDefault}}</td>
            <td>{{itemCount}}</td>
            <td><a class="btn btn-sm btn-primary" href="/a/navigation/{{id}}/edit">Edit</a></td>
        </tr>
        {{/menus}}
        </tbody>
    </table>
{{>partials/admin-shell-end.hbs}}
{{{bodyHtml}}}</body>
</html>
