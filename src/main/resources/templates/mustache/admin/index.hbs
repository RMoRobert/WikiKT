<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/admin-shell.hbs}}
    <h1 class="mb-4">Dashboard</h1>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card text-bg-primary h-100"><div class="card-body d-flex align-items-center gap-3">
                <i class="mdi mdi-file-document-outline fs-1 opacity-75" aria-hidden="true"></i>
                <div><div class="fs-3 fw-bold lh-1">{{pageCount}}</div><div class="small text-uppercase opacity-75">Pages</div></div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card text-bg-primary h-100"><div class="card-body d-flex align-items-center gap-3">
                <i class="mdi mdi-account-outline fs-1 opacity-75" aria-hidden="true"></i>
                <div><div class="fs-3 fw-bold lh-1">{{userCount}}</div><div class="small text-uppercase opacity-75">Users</div></div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card text-bg-primary h-100"><div class="card-body d-flex align-items-center gap-3">
                <i class="mdi mdi-account-group-outline fs-1 opacity-75" aria-hidden="true"></i>
                <div><div class="fs-3 fw-bold lh-1">{{groupCount}}</div><div class="small text-uppercase opacity-75">Groups</div></div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100"><div class="card-body d-flex align-items-center gap-3">
                <i class="mdi mdi-information-outline fs-1 text-secondary" aria-hidden="true"></i>
                <div><div class="fw-bold lh-1">{{appVersion}}{{#appGitSha}} <span class="small fw-normal text-secondary" title="Git commit">{{appGitSha}}</span>{{/appGitSha}}</div><div class="small text-secondary">{{siteName}} &middot; JDK {{jvmVersion}} &middot; {{dbEngine}}{{#appBuiltAt}} &middot; built {{appBuiltAt}}{{/appBuiltAt}}</div></div>
            </div></div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><i class="mdi mdi-history" aria-hidden="true"></i> Recently edited pages</div>
                {{#hasRecentPages}}
                <ul class="list-group list-group-flush">
                    {{#recentPages}}
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                        <a class="text-decoration-none text-truncate" href="{{url}}"><span class="fw-semibold">{{title}}</span> <span class="small text-secondary">{{locale}} · /{{path}}</span></a>
                        <span class="small text-secondary text-nowrap">{{updatedAt}}</span>
                    </li>
                    {{/recentPages}}
                </ul>
                {{/hasRecentPages}}
                {{^hasRecentPages}}<div class="card-body text-secondary">No pages yet.</div>{{/hasRecentPages}}
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><i class="mdi mdi-login-variant" aria-hidden="true"></i> Recent logins</div>
                {{#hasRecentLogins}}
                <ul class="list-group list-group-flush">
                    {{#recentLogins}}
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                        <span class="fw-semibold">{{username}}</span>
                        <span class="small text-secondary text-nowrap">{{at}}</span>
                    </li>
                    {{/recentLogins}}
                </ul>
                {{/hasRecentLogins}}
                {{^hasRecentLogins}}<div class="card-body text-secondary">No recent logins.</div>{{/hasRecentLogins}}
            </div>
        </div>
    </div>
{{>partials/admin-shell-end.hbs}}
{{{bodyHtml}}}</body>
</html>
