<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | General | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/admin-shell.hbs}}
    <h1>General</h1>
    {{#saved}}<div class="alert alert-success" role="alert">Settings saved.</div>{{/saved}}
    {{#reindexed}}<div class="alert alert-success" role="alert">Search index rebuilt.</div>{{/reindexed}}
    <form method="post" action="/a/settings" class="edit-form">
        {{{csrfField}}}
        <h2>Site</h2>
        <div class="mb-3">
            <label for="siteName" class="form-label">Site name</label>
            <input class="form-control" type="text" name="siteName" value="{{siteNameValue}}" placeholder="{{siteNameDefault}}" maxlength="100" id="siteName">
            <p class="form-text">Shown in page headers and browser title.</p>
        </div>

        <h2>Footer</h2>
        <div class="mb-3">
            <label for="siteOrgName" class="form-label">Organization name <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteOrgName" value="{{siteOrgNameValue}}" maxlength="100" placeholder="e.g. Acme" id="siteOrgName">
        </div>
        <div class="mb-3">
            <label for="siteContentLicense" class="form-label">Content license <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteContentLicense" value="{{siteContentLicenseValue}}" maxlength="200" placeholder="e.g. All rights reserved" id="siteContentLicense">
            <p class="form-text">A footer is generated from the two fields above, e.g. &ldquo;&copy; 2026 Acme, Inc. All rights reserved&rdquo;.</p>
        </div>
        <div class="mb-3">
            <label for="siteFooterOverride" class="form-label">Custom footer <span class="text-secondary">(optional)</span></label>
            <textarea class="form-control" name="siteFooterOverride" maxlength="1000" placeholder="e.g. &copy; &#123;&#123;year&#125;&#125; Acme, Inc. &mdash; [Privacy](/en/privacy)" id="siteFooterOverride">{{siteFooterOverrideValue}}</textarea>
            <p class="form-text">Used instead of the generated footer above. Basic Markdown is supported (links, bold, italic, etc.), and <code>&#123;&#123;year&#125;&#125;</code> is replaced with the current year.</p>
        </div>

        <h2>SEO</h2>
        <div class="mb-3">
            <label for="siteDescription" class="form-label">Default page description <span class="text-secondary">(optional)</span></label>
            <textarea class="form-control" name="siteDescription" rows="2" maxlength="500" placeholder="Used as the meta description for pages that don't set their own" id="siteDescription">{{siteDescriptionValue}}</textarea>
        </div>
        <div class="mb-3">
            <label for="siteMetaRobots" class="form-label">Default search-engine indexing (robots)</label>
            <select class="form-select" name="siteMetaRobots" id="siteMetaRobots">
                {{#siteRobotsOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/siteRobotsOptions}}
            </select>
            <p class="form-text">The default <code>&lt;meta name="robots"&gt;</code> for pages. Individual pages can override this from their Page Info panel.</p>
        </div>

        <h2>Editor</h2>
        <div class="mb-3" style="max-width:24rem">
            <label for="editorViewMode" class="form-label">Default editor view</label>
            <select class="form-select" name="editorViewMode" id="editorViewMode">
                {{#editorViewModeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/editorViewModeOptions}}
            </select>
            <p class="form-text">How the Markdown source is displayed while editing. <strong>Formatted</strong> renders inline styling as you type (<code>**bold**</code> appears bold, headings are sized). <strong>Plain text</strong> uses a monospace font and no styling at all, so the source reads as source. <strong>Basic</strong> sits between the two: monospace, but bold, italic and headings still show as bold. Editors can pick their own from the editor toolbar, and that choice is remembered in their browser.</p>
        </div>
        <div class="mb-3" style="max-width:24rem">
            <label for="editorTheme" class="form-label">Editor surface</label>
            <select class="form-select" name="editorTheme" id="editorTheme">
                {{#editorThemeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/editorThemeOptions}}
            </select>
            <p class="form-text">Light or dark background for the Markdown source you type. A dark editor keeps the source clearly distinct from the rendered preview beside it, which stays in the site theme either way. Editors can flip this for their own browser from the editor toolbar.</p>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>

    <h2>Search</h2>
    <p class="text-secondary">Search indexes updates on each page and fragment save. You can rebuild it manually here if results look stale.</p>
    <form method="post" action="/a/settings/reindex" class="edit-form">
        {{{csrfField}}}
        <button type="submit" class="btn btn-secondary">Rebuild search index</button>
    </form>
{{>partials/admin-shell-end.hbs}}
{{{bodyHtml}}}</body>
</html>
