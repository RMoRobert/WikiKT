<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Groups | Admin</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/admin-shell.hbs}}
    <div class="page-meta"><h1>Groups</h1><a class="btn btn-primary" href="/a/groups/new">New group</a></div>
    <table class="table table-hover align-middle">
        <thead><tr><th>Name</th><th>View</th><th>Edit</th><th>Manage Users</th><th>Manage Groups</th><th>System</th><th></th></tr></thead>
        <tbody>
        {{#groups}}
        <tr>
            <td>{{name}}</td>
            <td>{{canViewPages}}</td>
            <td>{{canEditPages}}</td>
            <td>{{canManageUsers}}</td>
            <td>{{canManageGroups}}</td>
            <td>{{isSystem}}</td>
            <td><a class="btn btn-sm btn-primary" href="/a/groups/{{id}}/settings">Edit</a></td>
        </tr>
        {{/groups}}
        </tbody>
    </table>
{{>partials/admin-shell-end.hbs}}
{{{bodyHtml}}}</body>
</html>
