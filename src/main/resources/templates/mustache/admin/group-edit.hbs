<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | {{group.name}} · Group | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/admin-shell.hbs}}
    <div class="page-meta">
        <h1><i class="mdi mdi-account-group-outline" aria-hidden="true"></i> {{group.name}}</h1>
        <a class="btn btn-outline-secondary btn-sm" href="/a/groups">Back to all groups</a>
    </div>

    {{! Client-side tabs: all four panes are rendered up front and Bootstrap toggles them with no server
        round-trip. The server marks the active pane (from the request path or a form post), so deep links
        and post-submit re-renders still land on the right tab. }}
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link {{#tab.settings}}active{{/tab.settings}}" id="grp-tab-settings" data-bs-toggle="tab" data-bs-target="#grp-settings" type="button" role="tab" aria-controls="grp-settings" aria-selected="{{#tab.settings}}true{{/tab.settings}}{{^tab.settings}}false{{/tab.settings}}">Settings</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link {{#tab.permissions}}active{{/tab.permissions}}" id="grp-tab-permissions" data-bs-toggle="tab" data-bs-target="#grp-permissions" type="button" role="tab" aria-controls="grp-permissions" aria-selected="{{#tab.permissions}}true{{/tab.permissions}}{{^tab.permissions}}false{{/tab.permissions}}">Permissions</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link {{#tab.rules}}active{{/tab.rules}}" id="grp-tab-rules" data-bs-toggle="tab" data-bs-target="#grp-rules" type="button" role="tab" aria-controls="grp-rules" aria-selected="{{#tab.rules}}true{{/tab.rules}}{{^tab.rules}}false{{/tab.rules}}">Page Rules</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link {{#tab.users}}active{{/tab.users}}" id="grp-tab-users" data-bs-toggle="tab" data-bs-target="#grp-users" type="button" role="tab" aria-controls="grp-users" aria-selected="{{#tab.users}}true{{/tab.users}}{{^tab.users}}false{{/tab.users}}">Users</button></li>
    </ul>

    <div class="tab-content">
    {{! ---- Settings tab: group name (+ delete) ---- }}
    <div class="tab-pane fade {{#tab.settings}}show active{{/tab.settings}}" id="grp-settings" role="tabpanel" aria-labelledby="grp-tab-settings">
        <h2 class="h4">Settings</h2>
        {{#settingsError}}<div class="alert alert-danger" role="alert">{{settingsError}}</div>{{/settingsError}}
        <form method="post" action="/a/groups/{{group.id}}/settings" class="edit-form">
            {{{csrfField}}}
            <div class="mb-3"><label class="form-label">Name</label><input class="form-control" type="text" name="name" value="{{group.name}}" {{#group.isSystem}}readonly{{/group.isSystem}} required></div>
            {{#group.isSystem}}<p class="form-text">This is a system group; its name can't be changed and it can't be deleted.</p>{{/group.isSystem}}
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
        {{^group.isSystem}}
        <form method="post" action="/a/groups/{{group.id}}/delete" class="mt-3" onsubmit="return confirm('Delete this group? Its members lose this group and its page rules are removed.');">
            {{{csrfField}}}
            <button type="submit" class="btn btn-danger">Delete group</button>
        </form>
        {{/group.isSystem}}
    </div>

    {{! ---- Permissions tab: global (admin) capabilities ---- }}
    <div class="tab-pane fade {{#tab.permissions}}show active{{/tab.permissions}}" id="grp-permissions" role="tabpanel" aria-labelledby="grp-tab-permissions">
        <h2 class="h4">Permissions</h2>
        <p class="text-secondary">Global (admin) capabilities for this group. Content access — reading and editing pages and assets — is granted per site and path on the <strong>Page Rules</strong> tab.</p>
        {{#isRoot}}<div class="alert alert-info">This group has <code>manage:system</code> (root) and can do everything. Those permissions are managed in code and can't be edited here.</div>{{/isRoot}}
        <form method="post" action="/a/groups/{{group.id}}/permissions" class="edit-form">
            {{{csrfField}}}
            <fieldset class="mb-3">
                {{#permissions}}
                <div class="form-check"><input class="form-check-input" type="checkbox" name="{{verb}}" {{#granted}}checked{{/granted}}><label class="form-check-label">{{label}} <code class="text-secondary">{{verb}}</code></label></div>
                {{/permissions}}
            </fieldset>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>

    {{! ---- Page Rules tab: per-group ALLOW/DENY content rules ---- }}
    <div class="tab-pane fade {{#tab.rules}}show active{{/tab.rules}}" id="grp-rules" role="tabpanel" aria-labelledby="grp-tab-rules">
        <h2 class="h4">Page Rules</h2>
        <p class="text-secondary">Rules grant (or deny) content actions — reading, writing, deleting pages and assets — scoped by <strong>site</strong>, <strong>path</strong>, and <strong>locale</strong>. Access is <strong>deny by default</strong>: a member can only do what a matching ALLOW rule grants. A more-specific rule wins, and DENY beats ALLOW on a tie.</p>
        {{#rulesError}}<div class="alert alert-danger" role="alert">{{rulesError}}</div>{{/rulesError}}
        <table class="table table-hover align-middle">
            <thead><tr><th>Effect</th><th>Roles</th><th>Match</th><th>Pattern</th><th>Sites</th><th>Locale</th><th></th></tr></thead>
            <tbody>
            {{#rules}}
            <tr>
                <td><strong>{{effect}}</strong></td>
                <td>{{roles}}</td>
                <td>{{matchLabel}}</td>
                <td><code>{{pattern}}</code></td>
                <td>{{sites}}</td>
                <td>{{locale}}</td>
                <td>
                    <form method="post" action="/a/groups/{{group.id}}/rules/{{id}}/delete" onsubmit="return confirm('Delete this rule?');">
                        {{{csrfField}}}<button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
            {{/rules}}
            {{^rules}}
            <tr><td colspan="7" class="text-secondary">No rules — this group has no content access (deny by default).</td></tr>
            {{/rules}}
            </tbody>
        </table>

        <h3>Add rule</h3>
        <form method="post" action="/a/groups/{{group.id}}/rules" class="edit-form">
            {{{csrfField}}}
            <div class="mb-3">
                <label class="form-label">Effect</label>
                <select class="form-select" name="effect">
                    <option value="ALLOW">ALLOW (grant)</option>
                    <option value="DENY">DENY (revoke)</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Actions <span class="text-secondary">(what this rule grants/denies)</span></label>
                {{#verbOptions}}
                <div class="form-check"><input class="form-check-input" type="checkbox" name="{{verb}}" {{#isRead}}checked{{/isRead}}><label class="form-check-label">{{label}} <code class="text-secondary">{{verb}}</code></label></div>
                {{/verbOptions}}
            </div>
            <div class="mb-3">
                <label class="form-label">Match type</label>
                <select class="form-select" name="matchType">
                    {{#matchTypes}}<option value="{{value}}">{{label}}</option>{{/matchTypes}}
                </select>
            </div>
            <div class="mb-3"><label class="form-label">Pattern <span class="text-secondary">(blank path = whole site)</span></label><input class="form-control" type="text" name="pattern" placeholder="e.g. docs/  or  ^(.*/)?beta-"></div>
            <div class="mb-3">
                <label class="form-label">Sites <span class="text-secondary">(none selected = all sites)</span></label>
                <select class="form-select" name="sites" multiple size="3">
                    {{#siteOptions}}<option value="{{id}}">{{name}}</option>{{/siteOptions}}
                </select>
            </div>
            <div class="mb-3"><label class="form-label">Locale <span class="text-secondary">(optional; blank = all locales)</span></label><input class="form-control" type="text" name="locale" placeholder="all locales"></div>
            <button type="submit" class="btn btn-primary">Add rule</button>
        </form>

        <details>
            <summary>How rules are resolved</summary>
            <p class="text-secondary">The most specific matching rule wins: a longer pinned path beats a shorter one (<code>docs/api</code> overrides <code>docs/</code>), an exact path beats a prefix, and a site- or locale-scoped rule beats an all-sites/all-locales one. On a full tie, <strong>DENY beats ALLOW</strong>. Resolution spans all of a user's groups. Regex uses <code>.test()</code> semantics and unsafe expressions are rejected on save.</p>
        </details>
    </div>

    {{! ---- Users tab: membership from the group side ---- }}
    <div class="tab-pane fade {{#tab.users}}show active{{/tab.users}}" id="grp-users" role="tabpanel" aria-labelledby="grp-tab-users">
        <h2 class="h4">Users</h2>
        <p class="text-secondary">Select which users belong to this group. (Membership can also be edited per-user under Users.)</p>
        <form method="post" action="/a/groups/{{group.id}}/users" class="edit-form">
            {{{csrfField}}}
            <fieldset class="mb-3">
                {{#users}}
                <div class="form-check"><input class="form-check-input" type="checkbox" name="userIds" value="{{id}}" {{#selected}}checked{{/selected}}><label class="form-check-label">{{username}}</label></div>
                {{/users}}
                {{^users}}<p class="text-secondary">No users exist yet.</p>{{/users}}
            </fieldset>
            <button type="submit" class="btn btn-primary">Save membership</button>
        </form>
    </div>
    </div>
<script>
// Keep the address bar in step with the active tab so a reload or bookmark reopens the same pane —
// without a server round-trip when switching (Bootstrap toggles the panes client-side).
(function () {
    var base = '/a/groups/{{group.id}}';
    var urls = { 'grp-tab-settings': base + '/settings', 'grp-tab-permissions': base + '/permissions', 'grp-tab-rules': base + '/rules', 'grp-tab-users': base + '/users' };
    document.querySelectorAll('#grp-tab-settings, #grp-tab-permissions, #grp-tab-rules, #grp-tab-users').forEach(function (btn) {
        btn.addEventListener('shown.bs.tab', function (e) {
            var url = urls[e.target.id];
            if (url && window.history && history.replaceState) history.replaceState(null, '', url);
        });
    });
})();
</script>
{{>partials/admin-shell-end.hbs}}
{{{bodyHtml}}}</body>
</html>
