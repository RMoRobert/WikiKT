<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{! While a background sync runs, reload this page every few seconds. Once it clears, the tag is }}
    {{! no longer rendered, so refreshing stops on its own and the Last-run panel shows the outcome. }}
    {{#syncRunning}}<meta http-equiv="refresh" content="4">{{/syncRunning}}
    <title>Admin | Storage and backup | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/admin-shell.hbs}}
    <h1>Storage and backup</h1>

    {{#saved}}<div class="alert alert-success" role="alert">Git sync settings saved.</div>{{/saved}}
{{#syncRunning}}<div class="alert alert-info" role="alert"><i class="mdi mdi-loading mdi-spin" aria-hidden="true"></i> Sync is running. The <b>Status</b> text below will update when it finishes.</div>{{/syncRunning}}
    {{#restored}}<div class="alert alert-success" role="alert"><i class="mdi mdi-check-circle-outline" aria-hidden="true"></i> {{restored}}</div>{{/restored}}
    {{#error}}<div class="alert alert-danger" role="alert"><i class="mdi mdi-alert-circle-outline" aria-hidden="true"></i> {{error}}</div>{{/error}}
    {{#historySaved}}<div class="alert alert-success" role="alert"><i class="mdi mdi-check-circle-outline" aria-hidden="true"></i> History retention saved.</div>{{/historySaved}}
    {{#uploadsSaved}}<div class="alert alert-success" role="alert"><i class="mdi mdi-check-circle-outline" aria-hidden="true"></i> Upload settings saved.</div>{{/uploadsSaved}}
    {{#purgeMessage}}<div class="alert alert-success" role="alert"><i class="mdi mdi-broom" aria-hidden="true"></i> {{purgeMessage}}</div>{{/purgeMessage}}

    <h2><i class="mdi mdi-git" aria-hidden="true"></i> Git sync</h2>
    <p class="text-secondary">Mirror wiki content to a git repository. Pages are written as
        <code>{locale}/{path}.md</code> (or <code>.html</code>) with YAML front-matter for metadata,
        and uploaded assets are stored as files at their paths. Requires <code>git</code> on the server.</p>

    <form method="post" action="/a/git-sync" class="edit-form">
        {{{csrfField}}}
        <h3 class="h5 mt-3">Synchronization</h3>
        <div class="mb-3">
            <label class="form-label">Mode</label>
            <select class="form-select" name="gitSyncMode">
                {{#modeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/modeOptions}}
            </select>
            <p class="form-text">Push mirrors local content into the repository,
                overwriting any content there. Pull applies what changed in the repository since the last sync (including deletions)
                to the local content, overwriting it if necessary. Bidirectional pulls first, then pushes.</p>
        </div>
        <div class="mb-3">
            <label class="form-label">Automatic sync</label>
            <select class="form-select" name="gitSyncInterval">
                {{#intervalOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/intervalOptions}}
            </select>
            <p class="form-text">How often a sync runs on its own (if enabled). Use "Sync now" below to run manually any time.</p>
        </div>
        <div class="mb-3">
            <label class="form-label">Repository URL</label>
            <input class="form-control" type="text" name="gitSyncRepoUrl" value="{{repoUrlValue}}" placeholder="https://github.com/you/wiki.git" maxlength="500">
            <p class="form-text">HTTPS or SSH. SSH URLs (<code>git@github.com:you/wiki.git</code>) use this server's own SSH keys and git configuration.</p>
        </div>
        <div class="mb-3">
            <label class="form-label">Branch</label>
            <input class="form-control" type="text" name="gitSyncBranch" value="{{branchValue}}" placeholder="{{branchDefault}}" maxlength="200">
        </div>

        <h3 class="h5 mt-3">HTTPS authentication <span class="text-secondary fs-6">(optional)</span></h3>
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input class="form-control" type="text" name="gitSyncUsername" value="{{usernameValue}}" placeholder="git" maxlength="200" autocomplete="off">
        </div>
        <div class="mb-3">
            <label class="form-label">Personal access token/password</label>
            <input class="form-control" type="password" name="gitSyncToken" value="" placeholder="{{#hasToken}}(unchanged — a token is stored){{/hasToken}}{{^hasToken}}(none stored){{/hasToken}}" maxlength="500" autocomplete="new-password">
            {{#hasToken}}
            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="gitSyncClearToken" id="gitSyncClearToken">
                <label class="form-check-label" for="gitSyncClearToken">Clear the stored token</label>
            </div>
            {{/hasToken}}
            <p class="form-text">Used for HTTPS remotes only. Leave blank to keep the current token.</p>
        </div>

        <h3 class="h5 mt-3">Commit author</h3>
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control" type="text" name="gitSyncAuthorName" value="{{authorNameValue}}" placeholder="WikiKT" maxlength="200">
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="text" name="gitSyncAuthorEmail" value="{{authorEmailValue}}" placeholder="wikikt@localhost" maxlength="200">
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>

    <h3 class="h5 mt-4">Status</h3>
    <div id="git-sync-status">
        {{#hasLastRun}}
        <p>
            Last run: <strong>{{lastRunAt}}</strong> —
            {{#lastRunOk}}<span class="badge text-bg-success">OK</span>{{/lastRunOk}}
            {{^lastRunOk}}<span class="badge text-bg-danger">Failed</span>{{/lastRunOk}}
            {{#lastRunCommit}} <code>{{lastRunCommit}}</code>{{/lastRunCommit}}
            <br><span class="text-secondary">{{lastRunResult}}</span>
        </p>
        {{/hasLastRun}}
        {{^hasLastRun}}<p class="text-secondary">Never synchronized.</p>{{/hasLastRun}}
    </div>
    <form method="post" action="/a/git-sync/run" class="edit-form d-inline-block me-2">
        {{{csrfField}}}
        <button type="submit" class="btn btn-secondary" data-busy-label="Syncing…" {{#syncRunning}}disabled{{/syncRunning}}><i class="mdi mdi-sync" aria-hidden="true"></i> Sync now</button>
    </form>
    <p class="form-text">Runs one sync as configured.</p>

    <h3 class="h5 mt-4">Actions</h3>
    <p class="text-secondary">Force a full re-sync in either direction, regardless of the mode above.</p>
    <form method="post" action="/a/git-sync/export" class="edit-form d-inline-block me-2">
        {{{csrfField}}}
        <button type="submit" class="btn btn-outline-secondary" data-busy-label="Exporting…" {{#syncRunning}}disabled{{/syncRunning}}><i class="mdi mdi-upload-outline" aria-hidden="true"></i> Export everything to repository</button>
    </form>
    <form method="post" action="/a/git-sync/import" class="edit-form d-inline-block"
          onsubmit="return confirm('Import everything from the repository? Repository content overwrites matching wiki pages and assets (prior versions are kept in each page\'s history). Nothing is deleted.');">
        {{{csrfField}}}
        <button type="submit" class="btn btn-outline-secondary" data-busy-label="Importing…" {{#syncRunning}}disabled{{/syncRunning}}><i class="mdi mdi-download-outline" aria-hidden="true"></i> Import everything from repository</button>
    </form>
    <p class="form-text">Export commits and pushes the complete wiki state. Import upserts every file from the repository into
        the wiki without deleting anything.</p>

    <hr class="my-4">

    <h2><i class="mdi mdi-history" aria-hidden="true"></i> History retention</h2>
    <p class="text-secondary">How many prior versions to keep for this site. When a page or asset changes,
        its previous version is saved to history; versions beyond the limit are purged automatically.
        Low asset history values in particular are suggested (including 0 if no need) to save storage space.</p>
    <form method="post" action="/a/storage/retention" class="edit-form">
        {{{csrfField}}}
        <div class="row g-3" style="max-width:32rem">
            <div class="col-sm-6">
                <label class="form-label" for="maxPageRevisions">Page versions to keep</label>
                <input class="form-control" type="number" id="maxPageRevisions" name="maxPageRevisions"
                       min="1" max="500" value="{{maxPageRevisions}}" required>
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="maxAssetRevisions">Asset versions to keep</label>
                <input class="form-control" type="number" id="maxAssetRevisions" name="maxAssetRevisions"
                       min="1" max="500" value="{{maxAssetRevisions}}" required>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-3"><i class="mdi mdi-content-save-outline" aria-hidden="true"></i> Save retention</button>
    </form>

    <h3 class="h5 mt-4">Purge history</h3>
    <p class="text-secondary">A one-time cleanup that permanently deletes stored page and asset versions
        older than the selected age (or all history if selected). The current live content and files are never
        touched. <strong>This cannot be undone</strong>.</p>
    <form method="post" action="/a/storage/purge-history" class="edit-form"
          onsubmit="return confirm('Permanently delete the selected history for this site? All selected older versions will be irrecoverably removed.');">
        {{{csrfField}}}
        <div class="d-flex flex-wrap align-items-end gap-2" style="max-width:32rem">
            <div>
                <label class="form-label" for="amount">Older than</label>
                <input class="form-control" type="number" id="amount" name="amount" min="1" max="10000" value="6" style="max-width:7rem">
            </div>
            <div>
                <label class="form-label" for="unit">&nbsp;</label>
                <select class="form-select" id="unit" name="unit" style="max-width:11rem">
                    <option value="days">days</option>
                    <option value="weeks">weeks</option>
                    <option value="months" selected>months</option>
                    <option value="all">— all history —</option>
                </select>
            </div>
            <button type="submit" class="btn btn-outline-danger"><i class="mdi mdi-broom" aria-hidden="true"></i> Purge history</button>
        </div>
    </form>

    <hr class="my-4">

    <h2><i class="mdi mdi-tray-arrow-up" aria-hidden="true"></i> Uploads</h2>
    <p class="text-secondary">The most files that can be sent in a single upload in the asset editor.
        Individual file size and allowed types are set in server configuration.</p>
    <form method="post" action="/a/storage/uploads" class="edit-form">
        {{{csrfField}}}
        <div style="max-width:20rem">
            <label class="form-label" for="maxUploadFiles">Maximum files per upload</label>
            <select class="form-select" id="maxUploadFiles" name="maxUploadFiles">
                {{#uploadFileOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/uploadFileOptions}}
            </select>
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="stripMetadata" name="stripMetadata" {{#stripMetadata}}checked{{/stripMetadata}}>
            <label class="form-check-label" for="stripMetadata">Remove image metadata (EXIF/GPS) on upload</label>
        </div>
        <button type="submit" class="btn btn-primary mt-3"><i class="mdi mdi-content-save-outline" aria-hidden="true"></i> Save upload settings</button>
    </form>

    <hr class="my-4">

    <h2><i class="mdi mdi-archive-outline" aria-hidden="true"></i> Backup and restore</h2>
    <h3 class="h5 mt-3">Download a backup</h3>
    <p class="text-secondary">A content backup is a single ZIP holding every page as a readable
        <code>{locale}/{path}.md</code> file (same format as Git sync), all uploaded
        assets, fragments, and navigation menu configuration.</p>
    <p>
        <a class="btn btn-primary" href="/a/backup/export"><i class="mdi mdi-download-outline" aria-hidden="true"></i> Download content backup</a>
    </p>
    {{#isRoot}}
    <form method="post" action="/a/backup/export/full" class="edit-form">
        {{{csrfField}}}
        <div class="mb-2" style="max-width:24rem;">
            <label class="form-label" for="backupSecretsPassword">Backup password <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="password" name="secretsPassword" id="backupSecretsPassword" autocomplete="new-password"
                   placeholder="Leave blank for an unencrypted backup">
            <div class="form-text"><strong>Set a password</strong> to create an encrypted backup that cannot be restored
                without the password and will include all data above plus your stored credentials (SMTP password, git
                token). Leave blank for unencrypted backup, which will omit this data.</div>
        </div>
        <button type="submit" class="btn btn-outline-primary"><i class="mdi mdi-database-export-outline" aria-hidden="true"></i> Download full backup</button>
    </form>
    <p class="form-text">A <strong>full backup</strong> additionally contains the complete database — user accounts,
        groups, permissions, revision history, API keys, and all settings — plus archived
        asset versions, restoring an identical site. Encrypted backups (see above) are suggested for maximum data.
        Full backup and restore are available to root administrators only.</p>
    {{/isRoot}}

    <h3 class="h5 mt-4">Restore</h3>
    <p class="text-secondary">Restoring a content backup upserts the backup's pages, assets, fragments, and menus into
        this site. Existing pages are updated (previous version kept page history), and nothing is deleted.
        Restoring a <strong>full</strong> backup replaces all site data (accounts, groups, settings, content, and history)
        with the data from the backup, and will log out all users and require you to log back in with credentials from a
        user account in the backup.</p>
    <form method="post" action="/a/backup/restore" enctype="multipart/form-data" class="edit-form"
          onsubmit="var cf = document.getElementById('confirmFull'); return confirm(cf && cf.checked
              ? 'FULL RESTORE: this REPLACES every account, setting, page, and asset on this site with the data from the backup. This cannot be undone. Continue?'
              : 'CONTENT RESTORE: matching content will be overwritten with content from the backup, new pages added, and nothing deleted. This can only be undone manually for affected pages/assets. Continue?');">
        {{{csrfField}}}
        <div class="mb-3">
            <input class="form-control" type="file" name="backupFile" accept=".zip,application/zip" required>
        </div>
        {{#isRoot}}
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="confirmFull" value="1" id="confirmFull">
            <label class="form-check-label" for="confirmFull">This is a <strong>full</strong> backup: replace all site data</label>
        </div>
        {{/isRoot}}
        <div class="mb-3" style="max-width:24rem;">
            <label class="form-label" for="restoreSecretsPassword">Backup password <span class="text-secondary">(if encrypted)</span></label>
            <input class="form-control" type="password" name="secretsPassword" id="restoreSecretsPassword" autocomplete="new-password"
                   placeholder="Required to restore an encrypted backup">
            <div class="form-text">If the backup was created with a password it's fully encrypted and can only be
                restored with that same password. Leave blank for an unencrypted backup.</div>
        </div>
        <button type="submit" class="btn btn-secondary"><i class="mdi mdi-upload-outline" aria-hidden="true"></i> Restore backup</button>
    </form>
<script>
// Progressive enhancement for the Git sync actions: they kick off a background run and redirect
// back here. Show a spinner on the clicked button and hide the now-stale status for the brief
// moment before the redirect lands (which re-renders with the "in progress" banner).
(function () {
    var status = document.getElementById('git-sync-status');
    document.querySelectorAll('form[action^="/a/git-sync/"]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            if (e.defaultPrevented) return; // a confirm() dialog was cancelled — no submit happening
            var btn = form.querySelector('button[type="submit"]');
            if (!btn) return;
            var label = btn.getAttribute('data-busy-label') || 'Working…';
            btn.innerHTML = '<i class="mdi mdi-loading mdi-spin" aria-hidden="true"></i> ' + label;
            btn.setAttribute('aria-busy', 'true');
            // Disable every sync action so a second run can't be started mid-sync.
            document.querySelectorAll('form[action^="/a/git-sync/"] button[type="submit"]')
                .forEach(function (b) { b.disabled = true; });
            if (status) status.hidden = true;
        });
    });
})();
</script>
{{>partials/admin-shell-end.hbs}}
{{{bodyHtml}}}</body>
</html>
