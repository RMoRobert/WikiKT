<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Appearance | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/admin-shell.hbs}}
    <h1>Appearance</h1>
    {{#saved}}<div class="alert alert-success" role="alert">Settings saved.</div>{{/saved}}
    {{#appearanceError}}<div class="alert alert-danger" role="alert">{{appearanceError}}</div>{{/appearanceError}}
    <form method="post" action="/a/settings/appearance" class="edit-form">
        {{{csrfField}}}
        <h2>Theme</h2>
        <div class="mb-4" style="max-width:22rem">
            <label class="form-label" for="siteTheme">Default theme mode</label>
            <select class="form-select" id="siteTheme" name="siteTheme">
                {{#themeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/themeOptions}}
            </select>
            <p class="form-text">Signed-in users can override their own theme (Account | Settings) for their account,
                and guests can use theme switcher button (if enabled below) to persist choice in browser.</p>
        </div>
        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" name="showThemePicker" id="showThemePicker" value="1" {{#showThemePicker}}checked{{/showThemePicker}}>
            <label class="form-check-label" for="showThemePicker">Show the theme switcher (<i class="mdi mdi-theme-light-dark" aria-hidden="true"></i>) in the header</label>
            <p class="form-text">Lets visitors change the theme mode (light/dark) themselves. Turning off uses only admin-selected theme, or logged in users can override in account settings for themselves.</p>
        </div>

        <h2>Branding</h2>
        <div class="mb-3">
            <label class="form-label">Logo <span class="text-secondary">(optional)</span></label>
            <input type="hidden" name="siteLogoUrl" id="logoUrl" value="{{logoValue}}">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <img id="logoPreview" alt="" style="width:36px;height:36px;object-fit:contain;border:1px solid var(--bs-border-color);border-radius:.25rem;background:var(--bs-tertiary-bg);padding:2px;" src="{{#logoValue}}{{logoValue}}{{/logoValue}}{{^logoValue}}/logo.svg{{/logoValue}}">
                <code id="logoLabel" class="text-secondary">{{#logoValue}}{{logoValue}}{{/logoValue}}{{^logoValue}}— Default (logo.svg) —{{/logoValue}}</code>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="browseLogo"><i class="mdi mdi-image-multiple-outline" aria-hidden="true"></i> Browse…</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="clearLogo">Use default</button>
            </div>
            <p class="form-text">Shown beside the site name. Defaults to the bundled <code>/logo.svg</code>; pick an uploaded image <a href="/f">asset</a> to override. For best results use a square image, at least 35x35px.</p>
        </div>
        <div class="mb-3">
            <label class="form-label">Favicon <span class="text-secondary">(optional)</span></label>
            <input type="hidden" name="siteFaviconUrl" id="faviconUrl" value="{{faviconValue}}">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <img id="faviconPreview" alt="" style="width:36px;height:36px;object-fit:contain;border:1px solid var(--bs-border-color);border-radius:.25rem;background:var(--bs-tertiary-bg);padding:2px;" src="{{#faviconValue}}{{faviconValue}}{{/faviconValue}}{{^faviconValue}}/favicon.svg{{/faviconValue}}">
                <code id="faviconLabel" class="text-secondary">{{#faviconValue}}{{faviconValue}}{{/faviconValue}}{{^faviconValue}}— Default (favicon.svg) —{{/faviconValue}}</code>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="browseFavicon"><i class="mdi mdi-image-multiple-outline" aria-hidden="true"></i> Browse…</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="clearFavicon">Use default</button>
            </div>
            <p class="form-text">The browser-tab icon. Defaults to the bundled <code>/favicon.svg</code>; pick an uploaded image <a href="/f">asset</a> to override (a square SVG or PNG works best).</p>
        </div>
        <h2>Colors</h2>
        <div class="mb-3">
            <label class="form-label" for="siteBrandColor">Primary color <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" id="siteBrandColor" name="siteBrandColor" value="{{siteBrandColorValue}}" placeholder="#0172ad" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})">
            <p class="form-text">A hex color (e.g. <code>#0172ad</code>) used as the accent for links and primary buttons. It must be dark enough to read as a link on a white page and behind white button text — WCAG AA, at least 4.5:1 against white — so choose a mid-to-dark shade. Leave blank for the default.</p>
        </div>
        <div class="mb-3">
            <label class="form-label" for="siteBrandColorDark">Primary color (dark mode) <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" id="siteBrandColorDark" name="siteBrandColorDark" value="{{siteBrandColorDarkValue}}" placeholder="#6ea8fe" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})">
            <p class="form-text">The link color used in dark mode, where the primary color above is usually too dark to read on the dark background. It must reach 4.5:1 against the dark background, so pick a lighter shade (e.g. <code>#6ea8fe</code>). Leave blank to keep the default dark-mode link color.</p>
        </div>
        <div class="mb-3">
            <label for="siteHeaderColor" class="form-label">Header color <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteHeaderColor" value="{{siteHeaderColorValue}}" placeholder="#1f2933" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteHeaderColor">
            <p class="form-text">A hex color for the top header bar in light mode (e.g. <code>#1f2933</code> for a dark bar). Leave blank for a subtly tinted default.</p>
        </div>
        <div class="mb-3">
            <label for="siteHeaderColorDark" class="form-label">Header color (dark mode) <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteHeaderColorDark" value="{{siteHeaderColorDarkValue}}" placeholder="#1f2933" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteHeaderColorDark">
            <p class="form-text">The header bar color used when the site is in dark mode. Leave blank for the default dark bar.</p>
        </div>
        <div class="mb-3">
            <label for="siteSidebarColor" class="form-label">Sidebar color <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteSidebarColor" value="{{siteSidebarColorValue}}" placeholder="#1976d2" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteSidebarColor">
            <p class="form-text">A hex color for the navigation sidebar in light mode. Text switches between light and dark automatically for contrast. Leave blank for the default blue.</p>
        </div>
        <div class="mb-3">
            <label for="siteSidebarColorDark" class="form-label">Sidebar color (dark mode) <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteSidebarColorDark" value="{{siteSidebarColorDarkValue}}" placeholder="#1a5487" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteSidebarColorDark">
            <p class="form-text">The sidebar color used when the site is in dark mode. Leave blank for the default deep blue.</p>
        </div>
        <div class="mb-3">
            <label for="siteSidebarHeaderLineColor" class="form-label">Sidebar divider color <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteSidebarHeaderLineColor" value="{{siteSidebarHeaderLineColorValue}}" placeholder="#1976d2" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteSidebarHeaderLineColor">
            <p class="form-text">The thin line along the top of the navigation sidebar, where it meets the header bar, in light mode. Useful when the header and sidebar colors match and the seam between them disappears. Leave blank to keep the tint derived from the sidebar color.</p>
        </div>
        <div class="mb-3">
            <label for="siteSidebarHeaderLineColorDark" class="form-label">Sidebar divider color (dark mode) <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteSidebarHeaderLineColorDark" value="{{siteSidebarHeaderLineColorDarkValue}}" placeholder="#212529" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteSidebarHeaderLineColorDark">
            <p class="form-text">The sidebar divider color used when the site is in dark mode.</p>
        </div>
        <div class="mb-3">
            <label for="siteNavHeadingColor" class="form-label">Sidebar menu header color <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteNavHeadingColor" value="{{siteNavHeadingColorValue}}" placeholder="#ffffff" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteNavHeadingColor">
            <p class="form-text">A hex color for <em>Header</em> items in the sidebar menu (the group labels you add under <a href="/a/navigation">Navigation</a>) in light mode. Leave blank to keep the muted tint derived from the sidebar color.</p>
        </div>
        <div class="mb-3">
            <label for="siteNavHeadingColorDark" class="form-label">Sidebar menu header color (dark mode) <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteNavHeadingColorDark" value="{{siteNavHeadingColorDarkValue}}" placeholder="#ffffff" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteNavHeadingColorDark">
            <p class="form-text">The sidebar menu header color used when the site is in dark mode.</p>
        </div>
        <div class="mb-3">
            <label class="form-label" for="searchBoxTheme">Search box</label>
            <select class="form-select" id="searchBoxTheme" name="searchBoxTheme">
                {{#searchBoxOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/searchBoxOptions}}
            </select>
        </div>
        <div class="mb-3">
            <label for="siteHeadingLineColor" class="form-label">Heading underline color <span class="text-secondary">(optional)</span></label>
            <input class="form-control" type="text" name="siteHeadingLineColor" value="{{siteHeadingLineColorValue}}" placeholder="#1976d2" pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})" id="siteHeadingLineColor">
            <p class="form-text">Section headings on wiki pages get a fading underline, and subsection headings a thin hairline, in this color. Leave blank for a neutral gray.</p>
        </div>

        <h2>Table of contents</h2>
        <div class="mb-3">
            <label for="tocMode" class="form-label">Position</label>
            <select class="form-select" name="tocMode" id="tocMode">
                {{#tocModeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/tocModeOptions}}
            </select>
            <p class="form-text">Auto-built from each page's H1 and H2 headings. If enabled, shown beside the content or, on narrow screens, under the page title.</p>
        </div>

        <h2>Content width</h2>
        <div class="mb-3">
            <label for="contentWidth" class="form-label">Page width</label>
            <select class="form-select" name="contentWidth" id="contentWidth">
                {{#contentWidthOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/contentWidthOptions}}
            </select>
            <p class="form-text">How wide wiki page content displays: capped at a comfortable reading width and centered
                beside the navigation sidebar (default/recommended), or spanning the full window width (even on ultra-wide screens).</p>
        </div>
        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" name="contentWidthUserChoice" id="contentWidthUserChoice" value="1" {{#contentWidthUserChoice}}checked{{/contentWidthUserChoice}}>
            <label class="form-check-label" for="contentWidthUserChoice">Let readers override the page width</label>
            <p class="form-text">Signed-in users get a page-width preference on their account page, and anyone can switch a single
                page view with <code>?fullWidth=true</code> (or <code>=false</code>) URL parameter. When off, all users/guests
                receive only the default above.</p>
        </div>

        <h2>Typography</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="bodyFont">Body font</label>
                <select class="form-select wk-font-select" id="bodyFont" name="bodyFont" data-custom="bodyFontCustomWrap">
                    {{#bodyFontOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/bodyFontOptions}}
                </select>
                <div class="mt-2 {{^bodyFontIsCustom}}d-none{{/bodyFontIsCustom}}" id="bodyFontCustomWrap">
                    <input class="form-control" type="text" name="bodyFontCustom" aria-label="Custom body font" value="{{bodyFontCustomValue}}" placeholder="'Inter', sans-serif" maxlength="200">
                    <p class="form-text mb-0">CSS <code>font-family</code> value; load the font itself in Custom CSS below.</p>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="headingFont">Heading font</label>
                <select class="form-select wk-font-select" id="headingFont" name="headingFont" data-custom="headingFontCustomWrap">
                    {{#headingFontOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/headingFontOptions}}
                </select>
                <div class="mt-2 {{^headingFontIsCustom}}d-none{{/headingFontIsCustom}}" id="headingFontCustomWrap">
                    <input class="form-control" type="text" name="headingFontCustom" aria-label="Custom heading font" value="{{headingFontCustomValue}}" placeholder="'Merriweather', serif" maxlength="200">
                    <p class="form-text mb-0">CSS <code>font-family</code> value; load the font itself in Custom CSS below.</p>
                </div>
            </div>
        </div>
        <p class="form-text">Built-in fonts load automatically from Google Fonts. Pick <strong>Custom…</strong> to use your own —
            enter its <code>font-family</code> and load it via Custom CSS below (<code>@font-face</code>, <code>@import</code>, or a
            self-hosted <a href="/f">asset</a>). Google Fonts and jsDelivr are allowed by default; other hosts
            must be added to the <a href="/a/security">content-security policy</a>.</p>
        <div class="mb-3" style="max-width:14rem">
            <label class="form-label" for="baseFontSize">Base text size</label>
            <div class="input-group">
                <input class="form-control" type="number" id="baseFontSize" name="baseFontSize" min="12" max="24" value="{{baseFontSizeValue}}">
                <span class="input-group-text">px</span>
            </div>
            <p class="form-text">Root body size (default 16). The rest scales from it.</p>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" name="emojiFont" value="1" id="emojiFont" {{#emojiFontValue}}checked{{/emojiFontValue}}>
            <label class="form-check-label" for="emojiFont">Enable standardized emoji font</label>
        </div>
        <p class="form-text mb-3">Render emoji ( <code>:smile:</code> shortcodes or literal characters) with
            Noto Color Emoji webfont, so a page looks the same on every device. Disable to use browser/OS default.</p>

        <h2>Custom CSS <span class="text-secondary fs-6">(advanced)</span></h2>
        <div class="mb-3">
            <textarea class="form-control text-body-emphasis" style="font-family:var(--bs-font-monospace);font-size:0.85rem" id="customCss" name="customCss" aria-label="Custom CSS" rows="8" spellcheck="false" placeholder=".content h1 { letter-spacing: -0.02em; }&#10;:root { --bs-border-radius: 0.75rem; }" maxlength="20000">{{customCssValue}}</textarea>
            <p class="form-text">Injected into <code>&lt;head&gt;</code> of every page after the theme, so it overrides built-i
                styles. Examples: theme via CSS variables like <code>--bs-primary</code>. External resources (images,
                <code>@import</code>, <code>@font-face</code>) may load from this server, Google Fonts, and jsDelivr by default;
                other hosts must be allowed by <a href="/a/security">content-security policy</a>.</p>
        </div>

        <h2>Custom HTML <span class="text-secondary fs-6">(advanced)</span></h2>
        <p class="text-secondary">Raw HTML injected verbatim into every page. Example uses: analytics, verification
            <code>&lt;meta&gt;</code> tags, chat widgets, etc. <strong>Unlike Custom CSS, this is not
            sanitized</strong>, so only trusted admins should use it; a mistake can break the page.
            <strong>Note:</strong> the content-security policy still applies: inline scripts run, but scripts loaded
            from an external host work only from allowed sources — add a third-party analytics host to
            <a href="/a/security">Security</a> first.</p>
        <div class="mb-3">
            <label class="form-label" for="headHtml">Head HTML <span class="text-secondary">— injected at the end of <code>&lt;head&gt;</code></span></label>
            <textarea class="form-control" style="font-family:var(--bs-font-monospace);font-size:0.85rem" id="headHtml" name="headHtml" rows="5" spellcheck="false" placeholder="&lt;meta name=&quot;google-site-verification&quot; content=&quot;…&quot;&gt;" maxlength="20000">{{headHtmlValue}}</textarea>
        </div>
        <div class="mb-3">
            <label class="form-label" for="bodyHtml">Body HTML <span class="text-secondary">— injected before <code>&lt;/body&gt;</code></span></label>
            <textarea class="form-control" style="font-family:var(--bs-font-monospace);font-size:0.85rem" id="bodyHtml" name="bodyHtml" rows="5" spellcheck="false" placeholder="&lt;script&gt;/* end-of-body script */&lt;/script&gt;" maxlength="20000">{{bodyHtmlValue}}</textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>

    {{! Read-only: asset delivery is instance-wide deployment config, not a per-site setting. Visible here so an
        admin can see the effective state and where to change it without hunting through docs. }}
    <h2>Asset delivery</h2>
    <p class="text-secondary">Where the front-end libraries and webfonts are fetched from. Configured by environment
        settings/variables at deployment time (see install readme); view-only here for reference. Per instance, not per site.</p>
    <div class="table-responsive mb-2">
        <table class="table table-sm align-middle">
            <thead><tr><th>Asset</th><th>Source</th><th>Environment variable</th></tr></thead>
            <tbody>
                {{#assetSources}}
                <tr>
                    <td>{{label}} <span class="text-secondary">{{size}}</span></td>
                    <td>{{#cdn}}<span class="badge text-bg-secondary">CDN</span> <span class="text-secondary">{{host}}</span>{{/cdn}}{{^cdn}}<span class="badge text-bg-success">Local</span> <span class="text-secondary">{{path}}</span>{{/cdn}}</td>
                    <td><code>{{env}}</code></td>
                </tr>
                {{/assetSources}}
            </tbody>
        </table>
    </div>
{{>partials/admin-shell-end.hbs}}
<script src="/static/wk-browser.js?v={{assetVersion}}"></script>
<script>
(function () {
  function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }
  function wire(kind, def) {
    var input = document.getElementById(kind + 'Url');
    var preview = document.getElementById(kind + 'Preview');
    var label = document.getElementById(kind + 'Label');
    var browse = document.getElementById('browse' + cap(kind));
    var clear = document.getElementById('clear' + cap(kind));
    if (!browse || !window.WikiKtAssetBrowser) return;
    browse.addEventListener('click', function () {
      WikiKtAssetBrowser.open({ imagesOnly: true, title: 'Select ' + cap(kind), confirmLabel: 'Choose' })
        .then(function (a) {
          if (!a) return;
          input.value = a.url; preview.src = a.url; label.textContent = a.url;
        });
    });
    clear.addEventListener('click', function () {
      input.value = ''; preview.src = def; label.textContent = '— Default (' + def.slice(1) + ') —';
    });
  }
  wire('logo', '/logo.svg');
  wire('favicon', '/favicon.svg');

  // Reveal the custom font-family field only when its select is on "Custom…".
  document.querySelectorAll('.wk-font-select').forEach(function (sel) {
    var wrap = document.getElementById(sel.dataset.custom);
    if (!wrap) return;
    sel.addEventListener('change', function () {
      wrap.classList.toggle('d-none', sel.value !== 'custom');
    });
  });
})();
</script>
{{{bodyHtml}}}</body>
</html>
