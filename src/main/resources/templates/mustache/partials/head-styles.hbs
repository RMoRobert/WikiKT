<script>(function(){try{var d=document.documentElement;var LI={{#loggedIn}}true{{/loggedIn}}{{^loggedIn}}false{{/loggedIn}};var DEF='{{themeMode}}';function dark(m){return m==='dark'||(m==='auto'&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches);}function apply(m){d.setAttribute('data-bs-theme',dark(m)?'dark':'light');window.__wkThemeMode=m;}window.wkApplyTheme=apply;window.__wkLoggedIn=LI;apply((LI?null:localStorage.getItem('wk-theme'))||DEF);if(window.matchMedia){window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){if(window.__wkThemeMode==='auto')apply('auto');});}}catch(e){}})();</script>
