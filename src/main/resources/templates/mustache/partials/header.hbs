{{! Skip link: the first focusable element on every page that renders this header, letting a keyboard
    user jump past the navbar (and breadcrumb band) straight to <main id="main">. Off-screen until
    focused — see .skip-link in site.css — then it slides in over the fixed navbar. }}
<a class="skip-link" href="#main">Skip to main content</a>
{{>partials/brand-style.hbs}}
<nav class="navbar navbar-expand-lg wk-navbar fixed-top shadow-sm py-2" data-bs-theme="dark">
    {{! Fluid, not .container: the brand hugs the viewport's left edge (over the full-bleed sidebar
        column) and the action icons the right edge. }}
    <div class="container-fluid">
        {{! Compact-screen sidebar trigger. Rendered on every page but kept hidden until the script below
            confirms a #wikiSidebar exists in the DOM (adds .is-active) — so admin/editor pages, which have
            no wiki sidebar, never show it. Sits at the far left, before the brand. }}
        <button type="button" class="wk-nav-toggle nav-icon" id="wikiNavToggle" aria-controls="wikiSidebar" aria-expanded="false" aria-label="Menu" title="Menu"><i class="mdi mdi-menu" aria-hidden="true"></i></button>
        <a class="navbar-brand brand" href="/">{{#siteLogoUrl}}<img class="brand-logo" src="{{siteLogoUrl}}" alt="">{{/siteLogoUrl}}<span class="brand-name">{{siteName}}</span></a>

        <!-- Action icons: always visible, right-aligned. -->
        <div class="header-actions d-flex align-items-center gap-1 ms-auto ms-lg-0 order-lg-3">
            <!-- Below lg the search box collapses; this icon reveals it as a full-width row. -->
            <button class="nav-icon d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#wkSearch" aria-controls="wkSearch" aria-expanded="false" aria-label="Toggle search">
                <i class="mdi mdi-magnify" aria-hidden="true"></i>
            </button>

            {{! Compact overflow ("More") menu, small screens (e.g., phones) only (below md). Folds the secondary actions
                (edit, theme picker, admin/exit, languages, etc.) into one Material-style kebab so
                the bar stays a single row on narrow screens. The individual icons that follow all carry
                `d-none d-md-flex`, so exactly one of the two layouts is visible at any width. The account
                icon and the search toggle stay top-level at every size. }}
            <div class="dropdown d-flex d-md-none">
                <button class="nav-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More" title="More">
                    <i class="mdi mdi-dots-vertical" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end wk-theme-menu"{{#loggedIn}} data-persist="/p/theme" data-csrf="{{csrfToken}}"{{/loggedIn}}>
                    {{#pageActions}}
                    <li><h6 class="dropdown-header">Page</h6></li>
                    {{#canEdit}}<li><a class="dropdown-item" href="{{editUrl}}"><i class="mdi mdi-pencil" aria-hidden="true"></i> Edit</a></li>{{/canEdit}}
                    {{#canViewHistory}}<li><a class="dropdown-item" href="{{historyUrl}}"><i class="mdi mdi-history" aria-hidden="true"></i> History</a></li>{{/canViewHistory}}
                    {{#canEdit}}<li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#convertPageModal"><i class="mdi mdi-swap-horizontal" aria-hidden="true"></i> Convert…</button></li>{{/canEdit}}
                    {{#canCreate}}<li><a class="dropdown-item" href="{{duplicateUrl}}"><i class="mdi mdi-content-copy" aria-hidden="true"></i> Duplicate</a></li>
                    <li><a class="dropdown-item" href="/new"><i class="mdi mdi-file-plus-outline" aria-hidden="true"></i> New page</a></li>{{/canCreate}}
                    {{#canEdit}}<li><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deletePageModal"><i class="mdi mdi-trash-can-outline" aria-hidden="true"></i> Delete…</button></li>{{/canEdit}}
                    {{/pageActions}}
                    {{^pageActions}}{{#canCreate}}<li><a class="dropdown-item" href="/new"><i class="mdi mdi-file-plus-outline" aria-hidden="true"></i> New page</a></li>{{/canCreate}}{{/pageActions}}
                    {{#showThemePicker}}
                    {{! Divider above Theme only when a Page group precedes it. Otherwise Theme is the first
                        group (e.g. a logged-out visitor whose only kebab option is the theme) and a leading
                        divider would be a stray line at the top of the menu. The two branches are mutually
                        exclusive, so at most one divider renders. }}
                    {{#pageActions}}<li><hr class="dropdown-divider"></li>{{/pageActions}}
                    {{^pageActions}}{{#canCreate}}<li><hr class="dropdown-divider"></li>{{/canCreate}}{{/pageActions}}
                    <li><h6 class="dropdown-header">Theme</h6></li>
                    <li><button type="button" class="dropdown-item" data-theme="light"><i class="mdi mdi-white-balance-sunny" aria-hidden="true"></i> Light</button></li>
                    <li><button type="button" class="dropdown-item" data-theme="dark"><i class="mdi mdi-weather-night" aria-hidden="true"></i> Dark</button></li>
                    <li><button type="button" class="dropdown-item" data-theme="auto"><i class="mdi mdi-brightness-auto" aria-hidden="true"></i> Auto</button></li>
                    {{/showThemePicker}}
                    {{#hasLocaleSwitcher}}
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Language</h6></li>
                    {{#localeSwitcher}}<li><a class="dropdown-item{{#current}} active{{/current}}" href="{{url}}">{{label}}{{#current}} <i class="mdi mdi-check" aria-hidden="true"></i>{{/current}}</a></li>{{/localeSwitcher}}
                    {{/hasLocaleSwitcher}}
                    {{#loggedIn}}
                    <li><hr class="dropdown-divider"></li>
                    {{#adminArea}}<li><a class="dropdown-item" href="/"><i class="mdi mdi-exit-to-app" aria-hidden="true"></i> Exit administration</a></li>{{/adminArea}}
                    {{^adminArea}}{{#canAdmin}}<li><a class="dropdown-item" href="/a"><i class="mdi mdi-cog" aria-hidden="true"></i> Administration</a></li>{{/canAdmin}}{{/adminArea}}
                    {{/loggedIn}}
                </ul>
            </div>

            {{#hasLocaleSwitcher}}
            <div class="dropdown d-none d-md-flex">
                <button class="nav-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Language" title="This page in other languages">
                    <i class="mdi mdi-web" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><h6 class="dropdown-header">Languages</h6></li>
                    {{#localeSwitcher}}
                    <li><a class="dropdown-item{{#current}} active{{/current}}" href="{{url}}">{{label}}{{#current}} <i class="mdi mdi-check" aria-hidden="true"></i>{{/current}}</a></li>
                    {{/localeSwitcher}}
                </ul>
            </div>
            {{/hasLocaleSwitcher}}

            {{#pageActions}}
            <div class="dropdown d-none d-md-flex">
                <button class="nav-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Page actions" title="Page actions">
                    <i class="mdi mdi-file-document-edit-outline" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    {{#canEdit}}<li><a class="dropdown-item" href="{{editUrl}}"><i class="mdi mdi-pencil" aria-hidden="true"></i> Edit</a></li>{{/canEdit}}
                    {{#canViewHistory}}<li><a class="dropdown-item" href="{{historyUrl}}"><i class="mdi mdi-history" aria-hidden="true"></i> History</a></li>{{/canViewHistory}}
                    {{#canEdit}}<li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#convertPageModal"><i class="mdi mdi-swap-horizontal" aria-hidden="true"></i> Convert…</button></li>{{/canEdit}}
                    {{#canCreate}}<li><a class="dropdown-item" href="{{duplicateUrl}}"><i class="mdi mdi-content-copy" aria-hidden="true"></i> Duplicate</a></li>{{/canCreate}}
                    {{#canCreate}}<li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/new"><i class="mdi mdi-file-plus-outline" aria-hidden="true"></i> New page</a></li>{{/canCreate}}
                    {{#canEdit}}<li><hr class="dropdown-divider"></li>
                    <li><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deletePageModal"><i class="mdi mdi-trash-can-outline" aria-hidden="true"></i> Delete…</button></li>{{/canEdit}}
                </ul>
            </div>
            {{/pageActions}}
            {{^pageActions}}{{#canCreate}}
            <a class="nav-icon d-none d-md-flex" href="/new" aria-label="New page" title="New page"><i class="mdi mdi-file-plus-outline" aria-hidden="true"></i></a>
            {{/canCreate}}{{/pageActions}}

            {{#showThemePicker}}
            <div class="dropdown d-none d-md-flex">
                <button class="nav-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Color theme" title="Color theme">
                    <i class="mdi mdi-theme-light-dark" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end wk-theme-menu"{{#loggedIn}} data-persist="/p/theme" data-csrf="{{csrfToken}}"{{/loggedIn}}>
                    <li><h6 class="dropdown-header">Theme</h6></li>
                    <li><button type="button" class="dropdown-item" data-theme="light"><i class="mdi mdi-white-balance-sunny" aria-hidden="true"></i> Light</button></li>
                    <li><button type="button" class="dropdown-item" data-theme="dark"><i class="mdi mdi-weather-night" aria-hidden="true"></i> Dark</button></li>
                    <li><button type="button" class="dropdown-item" data-theme="auto"><i class="mdi mdi-brightness-auto" aria-hidden="true"></i> Auto</button></li>
                </ul>
            </div>
            {{/showThemePicker}}

            {{#loggedIn}}
            {{#adminArea}}
            <a class="nav-icon nav-icon-label d-none d-md-flex" href="/" aria-label="Return to site" title="Exit Administration Area"><i class="mdi mdi-exit-to-app" aria-hidden="true"></i> Back to Site</a>
            {{/adminArea}}
            {{^adminArea}}
            {{#canAdmin}}<a class="nav-icon d-none d-md-flex" href="/a" aria-label="Administration" title="Administration"><i class="mdi mdi-cog" aria-hidden="true"></i></a>{{/canAdmin}}
            {{/adminArea}}
            <div class="vr my-2 mx-1 text-white d-none d-md-block"></div>
            <div class="dropdown">
                <button class="nav-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account" title="{{username}}">
                    <i class="mdi mdi-account-circle" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end account-dropdown">
                    <li class="account-id">
                        {{#displayName}}<div class="account-name">{{displayName}}</div><div class="account-sub">{{username}}</div>{{/displayName}}
                        {{^displayName}}<div class="account-name">{{username}}</div>{{/displayName}}
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/p/settings"><i class="mdi mdi-account-cog-outline" aria-hidden="true"></i> Profile</a></li>
                    <li><form method="post" action="/logout" class="m-0">{{{csrfField}}}<button type="submit" class="dropdown-item"><i class="mdi mdi-logout" aria-hidden="true"></i> Log Out</button></form></li>
                </ul>
            </div>
            {{/loggedIn}}
            {{^loggedIn}}
            <a class="nav-icon" href="/login" aria-label="Login" title="Login"><i class="mdi mdi-login" aria-hidden="true"></i></a>
            {{/loggedIn}}
        </div>

        <!-- Search: centered inline box at lg+; below lg a full-width row revealed by the search icon. -->
        <div class="collapse navbar-collapse order-lg-2" id="wkSearch">
            {{! No data-bs-theme here -- the navbar's pinned-dark one would fix the box to a dark surface.
                Instead the admin's search-box preference is resolved per color mode (SettingsService.
                searchBoxSurface) and CSS picks between the two on the live root theme, so a visitor
                toggling light/dark re-surfaces the box without a reload. }}
            {{! No vertical margin at any width: at lg+ the box is inline in the bar, and below lg it is
                too (site.css re-boxes this collapse onto the top row rather than letting it wrap to a
                second one). The old `my-2` spaced it inside that second row, and being a Bootstrap
                utility it was !important — it out-measured the 2.6rem action icons and grew the bar. }}
            <form class="header-search mx-lg-auto" action="/s" method="get" role="search" autocomplete="off" data-wk-search-light="{{searchBoxLightMode}}" data-wk-search-dark="{{searchBoxDarkMode}}">
                <input type="hidden" name="locale" value="{{searchLocale}}">
                <div class="header-search-box">
                    <i class="mdi mdi-magnify" aria-hidden="true"></i>
                    {{! Custom autocomplete: an ARIA 1.2 combobox that owns the #siteSearchResults listbox
                        below. aria-expanded and aria-activedescendant are kept in sync by the script in this
                        partial; with the popup closed it degrades to a plain search field (Enter submits to /s). }}
                    <input type="search" name="q" id="siteSearch" value="{{searchQ}}" placeholder="Search…"
                           aria-label="Search pages" role="combobox" aria-autocomplete="list"
                           aria-expanded="false" aria-controls="siteSearchResults" aria-haspopup="listbox">
                </div>
                <ul id="siteSearchResults" class="search-dropdown" role="listbox" aria-label="Search suggestions" hidden></ul>
                {{! Off-screen live region: announces suggestion counts / "no results" to a screen reader
                    without moving focus off the input (aria-activedescendant tracks the current option). }}
                <div id="siteSearchStatus" class="visually-hidden" role="status" aria-live="polite"></div>
            </form>
        </div>
    </div>
</nav>
<script src="/static/site-header.js?v={{assetVersion}}"></script>
