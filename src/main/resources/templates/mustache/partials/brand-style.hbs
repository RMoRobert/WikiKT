{{! Brand / primary color. `--bs-primary` (the button background, with white text) uses the light color
    in BOTH modes — it's contrast-validated against white on save, so white button text stays readable.
    Link color is per color mode: the light color on the light body, the optional dark color on the dark
    body, each validated against its own background so a color tuned for one mode never lands unreadable
    in the other. Dark color unset => dark-mode links keep Bootstrap's (theme-lightened) default. }}
{{#siteBrandColor}}<style>:root{--bs-primary:{{siteBrandColor}};}:root:not([data-bs-theme='dark']){--bs-link-color:{{siteBrandColor}};--bs-link-hover-color:{{siteBrandColor}};}</style>{{/siteBrandColor}}
{{#siteBrandColorDark}}<style>:root[data-bs-theme='dark']{--bs-link-color:{{siteBrandColorDark}};--bs-link-hover-color:{{siteBrandColorDark}};}</style>{{/siteBrandColorDark}}
{{! Top bar + editor bar colors, one per color mode. Every foreground on those bars is built from
    --wk-navbar-tint (site.css), so a light color needs only that one triple flipped to black to re-tint
    the brand, action icons, editor title field and bar buttons together. :not/:root[..] scoping keeps
    each override inside its own color mode, mirroring the sidebar block below. }}
{{#siteHeaderColor}}<style>:root:not([data-bs-theme='dark']) .wk-navbar,:root:not([data-bs-theme='dark']) .editor-bar{--wk-navbar-bg:{{siteHeaderColor}};{{^siteHeaderColorIsDark}}--wk-navbar-tint:0,0,0;{{/siteHeaderColorIsDark}}}</style>{{/siteHeaderColor}}
{{#siteHeaderColorDark}}<style>:root[data-bs-theme='dark'] .wk-navbar,:root[data-bs-theme='dark'] .editor-bar{--wk-navbar-bg:{{siteHeaderColorDark}};{{^siteHeaderColorDarkIsDark}}--wk-navbar-tint:0,0,0;{{/siteHeaderColorDarkIsDark}}}</style>{{/siteHeaderColorDark}}
{{! Admin sidebar colors, one per color mode. A light color flips the white-based foreground tints
    (defaults in site.css) to black-based ones, plus an edge line so a pale column still reads
    against the canvas. :not/:root[..] scoping keeps each override inside its own color mode. }}
{{#siteSidebarColor}}<style>:root:not([data-bs-theme='dark']){--wk-sidebar-bg:{{siteSidebarColor}};{{^siteSidebarColorIsDark}}--wk-sidebar-fg:rgba(0,0,0,.82);--wk-sidebar-fg-muted:rgba(0,0,0,.55);--wk-sidebar-hover-bg:rgba(0,0,0,.07);--wk-sidebar-active-bg:rgba(0,0,0,.12);--wk-sidebar-line:rgba(0,0,0,.2);--wk-sidebar-edge:rgba(0,0,0,.15);{{/siteSidebarColorIsDark}}}</style>{{/siteSidebarColor}}
{{#siteSidebarColorDark}}<style>:root[data-bs-theme='dark']{--wk-sidebar-bg:{{siteSidebarColorDark}};{{^siteSidebarColorDarkIsDark}}--wk-sidebar-fg:rgba(0,0,0,.82);--wk-sidebar-fg-muted:rgba(0,0,0,.55);--wk-sidebar-hover-bg:rgba(0,0,0,.07);--wk-sidebar-active-bg:rgba(0,0,0,.12);--wk-sidebar-line:rgba(0,0,0,.2);--wk-sidebar-edge:rgba(0,0,0,.15);{{/siteSidebarColorDarkIsDark}}}</style>{{/siteSidebarColorDark}}
{{! Divider where the sidebar's top edge meets the header bar, one per color mode. The whole border
    shorthand is replaced (keeping site.css's --bs-border-width) rather than the --wk-sidebar-line color
    it defaults to, so the dividers *inside* the sidebar — nav-divider rules, the "Edit menu" separator —
    keep their background-derived tint. Set this when a site paints the header and the sidebar the same
    color and the seam between them disappears. }}
{{#siteSidebarHeaderLineColor}}<style>:root:not([data-bs-theme='dark']){--wk-sidebar-header-line:var(--bs-border-width) solid {{siteSidebarHeaderLineColor}};}</style>{{/siteSidebarHeaderLineColor}}
{{#siteSidebarHeaderLineColorDark}}<style>:root[data-bs-theme='dark']{--wk-sidebar-header-line:var(--bs-border-width) solid {{siteSidebarHeaderLineColorDark}};}</style>{{/siteSidebarHeaderLineColorDark}}
{{! Sidebar menu heading color, one per color mode. Emitted independently of the sidebar background
    blocks above — a site can recolor its headings without setting any sidebar color, and site.css falls
    back to the background-derived muted tint when these are unset. }}
{{#siteNavHeadingColor}}<style>:root:not([data-bs-theme='dark']){--wk-sidebar-heading-fg:{{siteNavHeadingColor}};}</style>{{/siteNavHeadingColor}}
{{#siteNavHeadingColorDark}}<style>:root[data-bs-theme='dark']{--wk-sidebar-heading-fg:{{siteNavHeadingColorDark}};}</style>{{/siteNavHeadingColorDark}}
{{! Content-heading underline color. site.css draws both heading underlines from it — the h2 fade
    and the h3 hairline — falling back to the neutral border color when unset. }}
{{#siteHeadingLineColor}}<style>:root{--wk-heading-line-color:{{siteHeadingLineColor}};}</style>{{/siteHeadingLineColor}}
