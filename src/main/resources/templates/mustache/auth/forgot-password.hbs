<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Reset your password | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/header.hbs}}
<div class="container wiki-layout">
{{>partials/sidebar.hbs}}
<main id="main" tabindex="-1" class="wiki-main">
    <div style="max-width:28rem;">
    <h1 class="h3 my-4">Reset your password</h1>
    {{#mailDisabled}}
        <div class="alert alert-info" role="alert">
            Self-service password reset isn't available on this site because email hasn't been set up.
            Please contact an administrator to have your password reset.
        </div>
        <p><a href="/login">Back to sign in</a></p>
    {{/mailDisabled}}
    {{^mailDisabled}}
    {{#sent}}
        <div class="alert alert-success" role="alert">
            If an account exists for that email address, we've sent a link to reset its password.
            Check your inbox (and spam folder).
        </div>
        <p><a href="/login">Back to sign in</a></p>
    {{/sent}}
    {{^sent}}
        {{#error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/error}}
        <p class="text-muted">Enter the email address for your account, and we will send instructions for resetting your password.</p>
        <form method="post" action="/forgot-password">
            {{{csrfField}}}
            <div class="mb-3">
                <label class="form-label" for="resetEmail">Email address</label>
                <input class="form-control" type="email" id="resetEmail" name="email" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary">Send reset link</button>
            <a href="/login" class="btn btn-link">Back to sign in</a>
        </form>
    {{/sent}}
    {{/mailDisabled}}
    </div>
</main>
</div>
{{>partials/footer.hbs}}
{{{bodyHtml}}}</body>
</html>
