<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assets | Broken references | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{! Admin console shell, like the rest of the asset manager — see list.hbs. }}
{{>partials/admin-shell.hbs}}
    <div class="page-meta">
        <h1><i class="mdi mdi-image-broken-variant" aria-hidden="true"></i> Broken asset references</h1>
        <a class="btn btn-secondary" href="/f">Back to All Assets</a>
    </div>

    <p class="text-secondary">
        Files referred to from a page, fragment, infobox, scheduled draft, footer override, or
        navigation entry that no asset provides (could be deleted, renamed, moved to another folder
        or locale, or never uploaded). Will render as broken image or dead link on page.
    </p>
    {{! The counterpart of /f/unused, scanning the same content through the same index. Two rules keep
        this list honest, and both matter if you change it:
        1. A reference is only broken when nothing can serve it -- the locale it binds to at serve time
           has no asset AND (with assets.localeFallback on) neither does the default locale.
        2. Plain links with no file extension are page links, not assets: a page path can never contain
           a period, so an extension-less target is a page that may simply not be written yet. Those are
           left out deliberately -- see the note below. }}
    <div class="alert alert-warning py-2">
        <i class="mdi mdi-alert-outline" aria-hidden="true"></i>
        Not everything is scanned: custom CSS/JavaScript (site-wide or per-page, including inline
        <code>style</code> attributes), URLs inside Mermaid diagrams, and injected head/body
        HTML are not checked. Links to <em>pages</em> that don't exist aren't listed here, either,
        only files. Relative references (<code>![](image.png)</code>) are checked in
        page bodies, where they resolve against the page's own path; others are listed under the
        <a href="#cant-be-checked">Should be absolute</a> section below.
    </div>

    {{#hasBroken}}
        <h2>Found <span class="text-secondary fs-6">({{brokenCount}})</span></h2>
        {{! Filtering, sorting, and paging are all server-side, /a/pages-style: header links and pager
            links carry the whole list state, and the form is a plain GET so a filtered view is a
            shareable URL. Hidden inputs re-carry sort/size through a submit (page resets on purpose --
            a new filter starts from its first page). }}
        <form method="get" action="/f/broken" class="row g-2 align-items-center mb-2" role="search" aria-label="Filter broken references">
            <div class="col-auto">
                <input type="search" class="form-control form-control-sm" name="q" value="{{q}}"
                       placeholder="Filter by file path…" aria-label="Filter by file path">
            </div>
            <div class="col-auto">
                <select class="form-select form-select-sm" name="locale" aria-label="Filter by locale">
                    <option value="">All locales</option>
                    {{#localeOptions}}
                    <option value="{{value}}"{{#selected}} selected{{/selected}}>{{value}}</option>
                    {{/localeOptions}}
                </select>
            </div>
            {{#sortParam}}<input type="hidden" name="sort" value="{{sortParam}}">{{/sortParam}}
            {{#dirParam}}<input type="hidden" name="dir" value="{{dirParam}}">{{/dirParam}}
            {{#sizeParam}}<input type="hidden" name="size" value="{{sizeParam}}">{{/sizeParam}}
            <div class="col-auto"><button type="submit" class="btn btn-sm btn-secondary">Apply</button></div>
            {{#isFiltered}}<div class="col-auto"><a class="btn btn-sm btn-outline-secondary" href="{{clearUrl}}">Clear</a></div>{{/isFiltered}}
            <div class="col-auto ms-auto text-secondary small">
                {{#hasRows}}Showing {{firstRow}}–{{lastRow}} of {{filteredCount}}{{#isFiltered}} matching{{/isFiltered}}{{/hasRows}}
            </div>
        </form>
        <div class="table-responsive">
            {{! The "Referenced from" column carries no sort link -- it holds a list, not one sortable value. }}
            <table class="table table-hover align-middle admin-sortable" id="brokenTable">
                <thead><tr>
                    {{#columns}}
                    <th scope="col" aria-sort="{{ariaSort}}"><a class="admin-sort" href="{{url}}">{{label}}<i class="mdi {{#ascending}}mdi-menu-up{{/ascending}}{{#descending}}mdi-menu-down{{/descending}}{{^ascending}}{{^descending}}mdi-unfold-more-horizontal admin-sort-idle{{/descending}}{{/ascending}}" aria-hidden="true"></i></a></th>
                    {{/columns}}
                    <th scope="col">Referenced from</th>
                </tr></thead>
                <tbody>
                {{#broken}}
                    <tr>
                        <td><code>{{path}}</code></td>
                        <td>{{locale}}</td>
                        <td>{{refCount}}</td>
                        <td>
                            <ul class="list-unstyled mb-0">
                            {{#sources}}
                                <li>
                                    <span class="badge text-bg-light">{{type}}</span>
                                    <a href="{{url}}">{{label}}</a>{{#hasLocale}} <span class="text-secondary">({{locale}})</span>{{/hasLocale}}
                                </li>
                            {{/sources}}
                            </ul>
                        </td>
                    </tr>
                {{/broken}}
                {{^hasRows}}
                    <tr><td colspan="4" class="text-secondary">No broken references match the current filter.</td></tr>
                {{/hasRows}}
                </tbody>
            </table>
        </div>
        <div class="admin-pager">
            {{#multiplePages}}
            <nav aria-label="Broken references pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item{{^hasPrev}} disabled{{/hasPrev}}">
                        {{#hasPrev}}<a class="page-link" href="{{prevUrl}}" rel="prev" aria-label="Previous"><i class="mdi mdi-chevron-left" aria-hidden="true"></i></a>{{/hasPrev}}
                        {{^hasPrev}}<span class="page-link" aria-hidden="true"><i class="mdi mdi-chevron-left"></i></span>{{/hasPrev}}
                    </li>
                    {{#pageLinks}}
                    {{#gap}}<li class="page-item disabled"><span class="page-link">…</span></li>{{/gap}}
                    {{^gap}}
                    <li class="page-item{{#current}} active{{/current}}">
                        {{#current}}<span class="page-link" aria-current="page">{{label}}</span>{{/current}}
                        {{^current}}<a class="page-link" href="{{url}}">{{label}}</a>{{/current}}
                    </li>
                    {{/gap}}
                    {{/pageLinks}}
                    <li class="page-item{{^hasNext}} disabled{{/hasNext}}">
                        {{#hasNext}}<a class="page-link" href="{{nextUrl}}" rel="next" aria-label="Next"><i class="mdi mdi-chevron-right" aria-hidden="true"></i></a>{{/hasNext}}
                        {{^hasNext}}<span class="page-link" aria-hidden="true"><i class="mdi mdi-chevron-right"></i></span>{{/hasNext}}
                    </li>
                </ul>
            </nav>
            {{/multiplePages}}
            <div class="admin-pager-sizes text-secondary">
                Rows per page:
                {{#sizeOptions}}
                {{#current}}<span class="admin-pager-size active" aria-current="true">{{label}}</span>{{/current}}
                {{^current}}<a class="admin-pager-size" href="{{url}}">{{label}}</a>{{/current}}
                {{/sizeOptions}}
            </div>
        </div>
    {{/hasBroken}}
    {{^hasBroken}}
        <p class="text-secondary">No broken references found.</p>
    {{/hasBroken}}

    {{! File references written as absolute URLs to another site hosted on this instance, where that
        site has nothing at the path. Checked with the viewing user's read access on the target site —
        crossUnchecked below names the ones that access didn't cover, which were NOT probed. Own-host
        absolute references are folded into the main table above instead. Extension-less links are
        skipped exactly like local ones (a page not written yet is not a broken file). }}
    {{#hasCrossBroken}}
    <h2 class="mt-4">On other sites of this instance <span class="text-secondary fs-6">({{crossBrokenCount}})</span></h2>
    <p class="text-secondary">File references pointing at another site hosted here that has no asset at that path.</p>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr>
                <th scope="col">Reference</th>
                <th scope="col">Refs</th>
                <th scope="col">Referenced from</th>
            </tr></thead>
            <tbody>
            {{#crossBroken}}
                <tr>
                    <td><code>{{url}}</code></td>
                    <td>{{refCount}}</td>
                    <td>
                        <ul class="list-unstyled mb-0">
                        {{#sources}}
                            <li>
                                <span class="badge text-bg-light">{{type}}</span>
                                <a href="{{url}}">{{label}}</a>{{#hasLocale}} <span class="text-secondary">({{locale}})</span>{{/hasLocale}}
                            </li>
                        {{/sources}}
                        </ul>
                    </td>
                </tr>
            {{/crossBroken}}
            </tbody>
        </table>
    </div>
    {{/hasCrossBroken}}
    {{#hasCrossUnchecked}}
    <p class="text-secondary mt-2"><i class="mdi mdi-eye-off-outline" aria-hidden="true"></i>
        Not checked (these reference another site of this instance, where your access may not extend):
        {{#crossUnchecked}}<code>{{.}}</code> {{/crossUnchecked}}
    </p>
    {{/hasCrossUnchecked}}

    {{! Relative references written where nothing can resolve them. Not listed as "broken" because we
        can't say whether they resolve -- that's exactly the problem with them. Infobox values and
        fragments are the cases worth acting on: a fragment resolves against whichever page includes it,
        and an infobox value is rendered without the page-relative pass at all, so the browser resolves
        it one path segment higher than the same markup in the page body. }}
    {{#hasUnresolvable}}
        <h2 class="mt-5" id="cant-be-checked">Should be absolute <span class="text-secondary fs-6">({{unresolvableCount}})</span></h2>
        <p class="text-secondary">
            These are written relative to the page but could appear in any (or no) pages
            at any path, which could lead to the reference pointing to a different file or none at all,
            depending on what page it is used in. These are not checked for validity above.
            Rewrite to use absolute path, i.e., a path starting with <code>/</code> (will assume page's own locale or
            fall back to default if not found in page locale).
        </p>
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="unresolvableTable">
                <thead><tr>
                    <th data-sort-type="text">Written as</th>
                    <th data-sort-type="text">Should be</th>
                    <th data-sort-type="number">References</th>
                    <th>Written in</th>
                </tr></thead>
                <tbody>
                {{#unresolvable}}
                    <tr>
                        <td><code>{{url}}</code></td>
                        <td>{{#suggestion}}<code>{{suggestion}}</code>{{/suggestion}}{{^suggestion}}<span class="text-secondary">—</span>{{/suggestion}}</td>
                        <td data-sort="{{refCount}}">{{refCount}}</td>
                        <td>
                            <ul class="list-unstyled mb-0">
                            {{#sources}}
                                <li>
                                    <span class="badge text-bg-light">{{type}}</span>
                                    <a href="{{url}}">{{label}}</a>{{#hasLocale}} <span class="text-secondary">({{locale}})</span>{{/hasLocale}}
                                </li>
                            {{/sources}}
                            </ul>
                        </td>
                    </tr>
                {{/unresolvable}}
                </tbody>
            </table>
        </div>
    {{/hasUnresolvable}}
</main></div>
<script src="/static/wk-browser.js?v={{assetVersion}}"></script>
<script>
  // Drag-to-resize on desktop for both tables (no-ops on touch/narrow screens, or if a table isn't on
  // the page). Click-to-sort stays only on the unresolvable table -- the broken table sorts
  // server-side through its header links, so its rows here are just the current page.
  (function () {
    if (!window.WkBrowserCore) return;
    window.WkBrowserCore.ensureStyle();
    ['brokenTable', 'unresolvableTable'].forEach(function (id) {
      var table = document.getElementById(id);
      if (!table) return;
      if (id === 'unresolvableTable') window.WkBrowserCore.enableTableSort(table, id);
      window.WkBrowserCore.enableColumnResize(table, id);
    });
  })();
</script>
{{>partials/footer.hbs}}
{{{bodyHtml}}}</body>
</html>
