<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account | {{siteName}}</title>
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/header.hbs}}
<main class="container">
    {{! Center the profile as a single fixed-width column (equal left/right margins) rather than
        letting the narrow forms hug the left edge of a full-width container. }}
    <div class="mx-auto" style="max-width: 40rem;">
    <div class="page-meta">
        <h1><i class="mdi mdi-account-cog-outline" aria-hidden="true"></i> Account</h1>
    </div>

    {{! Client-side tabs: all three panes are rendered up front and Bootstrap toggles them with no
        server round-trip. The server marks the active pane (from the request path or a form post), so
        deep links like /p/security and post-submit re-renders still land on the right tab. }}
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link {{#accountTab.account}}active{{/accountTab.account}}" id="acct-tab-account" data-bs-toggle="tab" data-bs-target="#acct-account" type="button" role="tab" aria-controls="acct-account" aria-selected="{{#accountTab.account}}true{{/accountTab.account}}{{^accountTab.account}}false{{/accountTab.account}}">Account</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link {{#accountTab.security}}active{{/accountTab.security}}" id="acct-tab-security" data-bs-toggle="tab" data-bs-target="#acct-security" type="button" role="tab" aria-controls="acct-security" aria-selected="{{#accountTab.security}}true{{/accountTab.security}}{{^accountTab.security}}false{{/accountTab.security}}">Security</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link {{#accountTab.apiKeys}}active{{/accountTab.apiKeys}}" id="acct-tab-apikeys" data-bs-toggle="tab" data-bs-target="#acct-apikeys" type="button" role="tab" aria-controls="acct-apikeys" aria-selected="{{#accountTab.apiKeys}}true{{/accountTab.apiKeys}}{{^accountTab.apiKeys}}false{{/accountTab.apiKeys}}">API keys</button></li>
    </ul>

    <div class="tab-content">
    {{! ---- Account tab: identity (read-only), profile, preferences, groups ---- }}
    <div class="tab-pane fade {{#accountTab.account}}show active{{/accountTab.account}}" id="acct-account" role="tabpanel" aria-labelledby="acct-tab-account">
        <dl class="row">
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">{{username}}</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">{{#email}}{{email}}{{/email}}{{^email}}<span class="text-secondary">Not set</span>{{/email}}</dd>
        </dl>
        <p class="form-text">Your username and email address are displayed for information only and cannot be changed except by an administrator.</p>

        {{#saved}}<div class="alert alert-success" role="alert">Settings saved.</div>{{/saved}}
        {{#settingsError}}<div class="alert alert-danger" role="alert">{{settingsError}}</div>{{/settingsError}}

        <form method="post" action="/p/settings" class="edit-form">
            {{{csrfField}}}
            <h2 class="h5 mt-2">My info</h2>
            <div class="mb-3">
                <label class="form-label" for="displayName">Display name</label>
                <input type="text" class="form-control" id="displayName" name="displayName" maxlength="100" value="{{displayName}}" placeholder="{{username}}">
                <div class="form-text">A friendly name shown instead of your username. Leave blank to use your username.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="jobTitle">Job title</label>
                <input type="text" class="form-control" id="jobTitle" name="jobTitle" maxlength="150" value="{{jobTitle}}">
            </div>
            <div class="mb-3">
                <label class="form-label" for="location">Location</label>
                <input type="text" class="form-control" id="location" name="location" maxlength="150" value="{{location}}">
            </div>

            <h2 class="h5 mt-4">Preferences</h2>
            <div class="mb-3">
                <label class="form-label" for="timezone">Time zone</label>
                <select class="form-select" id="timezone" name="timezone">
                    <option value="" {{#usingServerDefault}}selected{{/usingServerDefault}}>Server default ({{serverZone}})</option>
                    {{#timezoneOptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/timezoneOptions}}
                </select>
                <div class="form-text">Determines what time zone dates and times are displayed in for your account.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="dateFormatShort">Short date format</label>
                <select class="form-select" id="dateFormatShort" name="dateFormatShort">
                    {{#shortDateOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/shortDateOptions}}
                </select>
                <div class="form-text">Used for the compact dates shown with a time (page history, admin lists, etc.).</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="dateFormatLong">Long date format</label>
                <select class="form-select" id="dateFormatLong" name="dateFormatLong">
                    {{#longDateOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/longDateOptions}}
                </select>
                <div class="form-text">Used for date-only lines such as a page's &ldquo;last modified&rdquo; date.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="timeFormat">Time format</label>
                <select class="form-select" id="timeFormat" name="timeFormat">
                    {{#timeFormatOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/timeFormatOptions}}
                </select>
                <div class="form-text">Whether times display on a 12-hour (AM/PM) or 24-hour clock.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="userTheme">Color theme</label>
                <select class="form-select" id="userTheme" name="theme">
                    {{#userThemeOptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/userThemeOptions}}
                </select>
                <div class="form-text">Applies to your account on every device. Can also change with theme switcher on top bar if enabled on site.</div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>

        <h2 class="h5 mt-4">Groups</h2>
        {{#hasGroups}}
        <ul class="list-group">
            {{#groups}}
            <li class="list-group-item"><i class="mdi mdi-account-group" aria-hidden="true"></i> {{name}}</li>
            {{/groups}}
        </ul>
        {{/hasGroups}}
        {{^hasGroups}}
        <p class="text-secondary">You are not a member of any group.</p>
        {{/hasGroups}}
        <div class="form-text">Group membership is provided for information only; only administrator-level accounts can modify.</div>
    </div>

    {{! ---- Security tab: password + two-factor authentication ---- }}
    <div class="tab-pane fade {{#accountTab.security}}show active{{/accountTab.security}}" id="acct-security" role="tabpanel" aria-labelledby="acct-tab-security">
        <h2 class="h4">Password</h2>
        {{#pwSaved}}<div class="alert alert-success" role="alert">Password changed.</div>{{/pwSaved}}
        {{#pwError}}<div class="alert alert-danger" role="alert">{{pwError}}</div>{{/pwError}}
        <form method="post" action="/p/password" class="edit-form" autocomplete="off">
            {{{csrfField}}}
            <div class="mb-3">
                <label class="form-label" for="pwCurrent">Current password</label>
                <input type="password" class="form-control" id="pwCurrent" name="currentPassword" autocomplete="current-password" required>
            </div>
            <div class="mb-3">
                <label class="form-label" for="pwNew">New password</label>
                <input type="password" class="form-control" id="pwNew" name="newPassword" autocomplete="new-password" minlength="5" maxlength="72" required>
            </div>
            <div class="mb-3">
                <label class="form-label" for="pwConfirm">Confirm new password</label>
                <input type="password" class="form-control" id="pwConfirm" name="confirmPassword" autocomplete="new-password" required>
            </div>
            <button type="submit" class="btn btn-primary">Change password</button>
        </form>

        <h2 class="h4 mt-4">Two-factor authentication</h2>
        <p class="text-secondary">Add a second step at sign-in using an authenticator app (must support TOTP) for additional security.</p>

        {{#justEnabled}}<div class="alert alert-success" role="alert">Two-factor authentication is now on. Save your recovery codes below — they're shown only once.</div>{{/justEnabled}}
        {{#justDisabled}}<div class="alert alert-info" role="alert">Two-factor authentication has been turned off.</div>{{/justDisabled}}
        {{#mfaError}}<div class="alert alert-danger" role="alert">{{mfaError}}</div>{{/mfaError}}

        {{#recoveryCodes}}
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="h5">Your recovery codes</h3>
                <p class="text-secondary">Store these somewhere safe. Each code works once and can be used in place of an authenticator code if you lose your device.</p>
                <ul class="list-unstyled mb-0" style="font-family: monospace; font-size: 1.1rem; line-height: 1.9;">
                    {{#codes}}<li>{{code}}</li>{{/codes}}
                </ul>
            </div>
        </div>
        {{/recoveryCodes}}

        {{#mfaOn}}
        <p>Status: <strong class="text-success">On</strong> &middot; recovery codes remaining: <strong>{{remaining}}</strong></p>
        <form method="post" action="/p/security/regenerate" class="mb-4">
            {{{csrfField}}}
            <button type="submit" class="btn btn-outline-secondary">Regenerate recovery codes</button>
            <div class="form-text">Generates a fresh set and invalidates the old codes.</div>
        </form>
        <h3 class="h5">Turn off</h3>
        <form method="post" action="/p/security/disable" class="edit-form" autocomplete="off">
            {{{csrfField}}}
            <div class="mb-3">
                <label class="form-label" for="mfaDisablePassword">Confirm your password to turn off</label>
                <input type="password" class="form-control" id="mfaDisablePassword" name="currentPassword" autocomplete="current-password" required>
            </div>
            <button type="submit" class="btn btn-outline-danger">Turn off two-factor authentication</button>
        </form>
        {{/mfaOn}}

        {{#setup}}
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h5">Set up your authenticator</h3>
                <ol class="mb-3">
                    <li>Open your authenticator app (Google Authenticator, Aegis, 1Password, etc.)</li>
                    <li>Scan this QR code (or enter the setup key manually):</li>
                </ol>
                <div class="mb-3">{{{setup.qrSvg}}}</div>
                <details class="mb-3">
                    <summary>Show setup key</summary>
                    <p class="form-text mt-2 mb-1">If you can't scan the QR code, enter this key manually in your authenticator app to set up MFA.</p>
                    <p class="mb-0"><code style="font-size: 1.15rem; letter-spacing: 0.06em;">{{setup.secret}}</code></p>
                </details>
                <p><a href="{{setup.otpauthUri}}">Open in your authenticator app</a></p>
                <hr>
                <form method="post" action="/p/security/confirm" class="edit-form">
                    {{{csrfField}}}
                    <label class="form-label" for="code">Enter the 6-digit code from your authenticator app (after configuring) to enable:</label>
                    <div class="d-flex gap-2" style="max-width: 22rem;">
                        <input type="text" class="form-control" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" required>
                        <button type="submit" class="btn btn-primary">Confirm</button>
                    </div>
                </form>
            </div>
        </div>
        {{/setup}}

        {{#mfaOff}}
        <form method="post" action="/p/security/enable">
            {{{csrfField}}}
            <button type="submit" class="btn btn-primary">Set up two-factor authentication</button>
        </form>
        {{/mfaOff}}
    </div>

    {{! ---- API keys tab: the current user's own keys ---- }}
    <div class="tab-pane fade {{#accountTab.apiKeys}}show active{{/accountTab.apiKeys}}" id="acct-apikeys" role="tabpanel" aria-labelledby="acct-tab-apikeys">
        <div class="page-meta">
            <h2 class="mb-0">API keys</h2>
            {{#canCreate}}<a class="btn btn-primary" href="{{baseUrl}}/new">New key</a>{{/canCreate}}
        </div>
        {{#canManageAllKeys}}
        <p class="small"><a href="/a/api-keys"><i class="mdi mdi-shield-key-outline" aria-hidden="true"></i> Your account can manage all API keys for all users in the Administration area →</a></p>
        {{/canManageAllKeys}}
        {{>partials/api-keys-body.hbs}}
    </div>
    </div>
    </div>
</main>
<script>
// Keep the address bar in step with the active tab so a reload or bookmark reopens the same pane —
// without a server round-trip when switching (Bootstrap toggles the panes client-side).
(function () {
    var urls = { 'acct-tab-account': '/p/settings', 'acct-tab-security': '/p/security', 'acct-tab-apikeys': '/p/api-keys' };
    document.querySelectorAll('#acct-tab-account, #acct-tab-security, #acct-tab-apikeys').forEach(function (btn) {
        btn.addEventListener('shown.bs.tab', function (e) {
            var url = urls[e.target.id];
            if (url && window.history && history.replaceState) history.replaceState(null, '', url);
        });
    });
})();
</script>
{{>partials/footer.hbs}}
{{{bodyHtml}}}</body>
</html>
