<!DOCTYPE html>
{{! <html lang> is the language of the CHROME (nav, breadcrumbs, page-detail cards, footer), which is
    English-only for now — so it stays "en". The article body can be in a different locale; it carries
    its own lang on <article> below. When the UI itself becomes localized, swap this "en" for the UI
    locale. }}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | {{siteName}}</title>
    {{#hasMetaDescription}}<meta name="description" content="{{metaDescription}}">{{/hasMetaDescription}}
    <meta name="robots" content="{{metaRobots}}">
    {{>partials/head-deps.hbs}}
    <link rel="stylesheet" href="/static/vendor/highlight/github.min.css?v={{assetVersion}}">
    {{>partials/head-styles.hbs}}
    {{! Per-page custom code (Page Info → Custom Code), injected on view only. Set exclusively by users
        with manage:theme and stored unsanitized: CSS is wrapped in a <style> tag here; JS is emitted
        verbatim (the author supplied their own <script> tags). Triple-stache = raw, not HTML-escaped. }}
    {{#pageCustomCss}}<style>{{{pageCustomCss}}}</style>{{/pageCustomCss}}
    {{#pageCustomJs}}{{{pageCustomJs}}}{{/pageCustomJs}}
</head>
<body>
{{>partials/header.hbs}}
{{! Breadcrumb band: a full-width gray strip under the header, hidden on the home
    page. Its inner .container mirrors .wiki-layout's centering/offset so the crumbs align with the
    article's left edge. }}
{{#showBreadcrumbs}}
<nav class="wk-crumbbar" aria-label="breadcrumb">
    <div class="container">
        <ol class="breadcrumb">
            {{#breadcrumbs}}
            <li class="breadcrumb-item{{#isCurrent}} active{{/isCurrent}}"{{#isCurrent}} aria-current="page"{{/isCurrent}}>{{#isHome}}<a href="{{url}}" aria-label="Home" title="Home"><i class="mdi mdi-home" aria-hidden="true"></i></a>{{/isHome}}{{^isHome}}{{#isCurrent}}{{label}}{{/isCurrent}}{{^isCurrent}}{{#hasUrl}}<a href="{{url}}">{{label}}</a>{{/hasUrl}}{{^hasUrl}}{{label}}{{/hasUrl}}{{/isCurrent}}{{/isHome}}</li>
            {{/breadcrumbs}}
        </ol>
    </div>
</nav>
{{/showBreadcrumbs}}
<div class="container wiki-layout">
    {{>partials/sidebar.hbs}}
    <main id="main" tabindex="-1" class="wiki-main page-view">
        {{^published}}<div class="alert alert-warning d-flex align-items-center gap-2 py-2"><i class="mdi mdi-eye-off-outline" aria-hidden="true"></i>DRAFT: Page is not published</div>{{/published}}
        {{#previewingStaged}}<div class="alert alert-warning d-flex align-items-center gap-2 py-2"><i class="mdi mdi-eye-check-outline" aria-hidden="true"></i> Previewing staged version. <a href="{{viewUrl}}" class="alert-link">Switch to live view.</a></div>{{/previewingStaged}}
        {{#canEdit}}{{#hasStaged}}{{^previewingStaged}}<div class="alert alert-warning d-flex align-items-center gap-2 py-2"><i class="mdi mdi-clock-edit-outline" aria-hidden="true"></i> A staged update {{#stagedScheduled}}is scheduled for {{stagedScheduledAt}}{{/stagedScheduled}}{{^stagedScheduled}}is saved (no schedule){{/stagedScheduled}} — <a href="{{stagedPreviewUrl}}" class="alert-link">Preview</a> · <a href="{{editUrl}}" class="alert-link">Edit</a></div>{{/previewingStaged}}{{/hasStaged}}{{/canEdit}}
        {{! Name is set off with colon rather than run into "a/an <name> infobox", which reads
            awkwardly and can wrap oddly for longer names — same reasoning as the editor's General tab. }}
        {{! The sentence is wrapped in one <span> (not left as loose text + <strong> + <a> siblings) so it's
            a SINGLE flex item next to the icon — otherwise Bootstrap's flex "gap-2" inserts its gap between
            EVERY direct child of the flex container, including between "Integration" and the following
            period and between "Add it" and its period, showing as unwanted extra spaces before both. }}
        {{#infoboxMissing}}<div class="alert alert-warning d-flex align-items-center gap-2 py-2"><i class="mdi mdi-card-text-outline" aria-hidden="true"></i><span>This page is specified for but missing {{infoboxMissingNoun}}: <strong>{{infoboxMissingNames}}</strong>. <a href="{{editUrl}}" class="alert-link">Add {{infoboxMissingPronoun}}</a>.</span></div>{{/infoboxMissing}}
        {{>partials/ref-warning.hbs}}
        {{! The article body is the one region in a locale that can differ from the English chrome, so it
            carries lang here (not on <html>). The value is the URL's locale segment, which today always
            equals the served page's locale; if you add cross-locale content fallback later, bind it to the
            RESOLVED page's locale so fell-back English content isn't mislabelled as the requested locale.
            (Don't reference the locale variable inside this comment — its closing braces would end the
            comment early and dump the rest as visible text.) }}
        <article class="wiki-content" lang="{{locale}}">
            <header>
            <h1>{{title}}</h1>
            {{#hasDescription}}<p>{{description}}</p>{{/hasDescription}}
            </header>
            {{! Infobox: on desktop each card floats to the right edge of the article and the body text
                wraps around it (Wikipedia-style), stacking if the page has more than one; on compact
                screens each is a full-width block here at the top, under the TOC (relocated just above
                by the script). infoboxHtml already carries its own complete <aside> wrapper(s) — see
                InfoboxService.renderOneCard — so this is a direct passthrough, not wrapped again here. }}
            {{#hasInfobox}}{{{infoboxHtml}}}{{/hasInfobox}}
            {{{htmlContent}}}
        </article>
    </main>
    <aside class="page-aside {{asideClass}}">
        {{#tocEnabled}}
        {{! On compact screens the JS below moves this card under the page title and the title row
            becomes a collapse toggle (collapsed by default); on desktop it stays here, expanded,
            and the toggle is inert (CSS always shows the list). }}
        <nav class="page-toc page-card" id="pageToc" aria-label="Table of contents" hidden>
            <button type="button" class="page-toc-toggle" id="pageTocToggle" aria-expanded="false" aria-controls="pageTocList">
                <span class="page-card-title">On This Page</span>
                <i class="mdi mdi-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="page-toc-list" id="pageTocList"></ul>
        </nav>
        {{/tocEnabled}}
        {{#hasTags}}
        <div class="page-tag-box page-card">
            <p class="page-card-title">Tags</p>
            <div class="d-flex flex-wrap gap-2">
                {{#tags}}<a class="badge rounded-pill text-bg-light border text-decoration-none" href="{{url}}"><i class="mdi mdi-tag-outline" aria-hidden="true"></i> {{name}}</a>{{/tags}}
            </div>
        </div>
        {{/hasTags}}
        <div class="page-meta-box page-card">
            <p class="page-card-title">Page details</p>
            <p class="page-meta-row"><span class="page-meta-label">Last modified by</span> {{#hasUpdatedBy}}{{updatedByName}}{{/hasUpdatedBy}}{{^hasUpdatedBy}}—{{/hasUpdatedBy}}</p>
            <p class="page-meta-row"><span class="page-meta-label">Last modified on</span> {{updatedAt}}</p>
            {{#canViewHistory}}<p class="page-meta-row"><a href="{{historyUrl}}"><i class="mdi mdi-history" aria-hidden="true"></i> View history</a></p>{{/canViewHistory}}
        </div>
        <div class="page-card">
            <div class="d-flex justify-content-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="mdi mdi-share-variant" aria-hidden="true"></i> Share</button>
                    <ul class="dropdown-menu">
                        <li><button type="button" class="dropdown-item" id="shareCopyUrl"><i class="mdi mdi-link-variant" aria-hidden="true"></i> Copy URL</button></li>
                        <li><a class="dropdown-item" id="shareEmail" href="mailto:"><i class="mdi mdi-email-outline" aria-hidden="true"></i> E-mail</a></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="printPage" title="Print"><i class="mdi mdi-printer" aria-hidden="true"></i><span class="visually-hidden">Print</span></button>
            </div>
        </div>
    </aside>
</div>

{{#canEdit}}
{{! Page actions → Convert. Markdown→HTML renders the stored content through the pipeline and re-saves
    as HTML (server-side). HTML→Markdown isn't supported (no html-to-markdown lib), so we just explain. }}
<div class="modal fade" id="convertPageModal" tabindex="-1" aria-labelledby="convertPageTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="convertPageTitle"><i class="mdi mdi-swap-horizontal" aria-hidden="true"></i> Convert format</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        {{#isMarkdown}}
        <form method="post" action="{{editUrl}}">
            {{{csrfField}}}
            <input type="hidden" name="convertFormat" value="HTML">
            <div class="modal-body">
                <p>This page is written in <strong>Markdown</strong>. Convert it to <strong>HTML</strong>?</p>
                <p class="text-secondary mb-0">The Markdown is rendered to HTML once and the page is saved as HTML (a revision is kept). This can’t be automatically reversed.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary"><i class="mdi mdi-swap-horizontal" aria-hidden="true"></i> Convert to HTML</button>
            </div>
        </form>
        {{/isMarkdown}}
        {{^isMarkdown}}
        <div class="modal-body">
            <p>This page is written in <strong>HTML</strong>. Converting HTML back to <strong>Markdown</strong> isn’t supported yet.</p>
            <p class="text-secondary mb-0">Your content is left unchanged. To move to Markdown, re-create the page content in Markdown by hand, then it will round-trip cleanly.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        </div>
        {{/isMarkdown}}
    </div>
    </div>
</div>

<div class="modal fade" id="deletePageModal" tabindex="-1" aria-labelledby="deletePageTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
    <form method="post" action="{{editUrl}}">
        {{{csrfField}}}
        <input type="hidden" name="deletePage" value="1">
        <div class="modal-header">
            <h5 class="modal-title text-danger" id="deletePageTitle"><i class="mdi mdi-trash-can-outline" aria-hidden="true"></i> Delete page</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <p>Permanently delete <strong>{{title}}</strong> at <code>{{locale}}/{{pagePath}}</code>?</p>
            <p class="text-secondary mb-0">This removes the page and its full revision history, with no redirect left behind. This cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger"><i class="mdi mdi-trash-can-outline" aria-hidden="true"></i> Delete permanently</button>
        </div>
    </form>
    </div>
    </div>
</div>
{{/canEdit}}

{{>partials/footer.hbs}}
{{! Site-wide (content pages): stable ids + a copy-link icon on every section heading. Loaded BEFORE
    page-view.js so heading ids are already assigned; its TOC builder reuses them (window.wkEnsureHeadingId). }}
<script src="/static/heading-anchors.js?v={{assetVersion}}"></script>
{{! TOC builder + share box. The TOC part no-ops when the tocEnabled markup above wasn't rendered
    (it early-returns without #pageToc), so no conditional is needed around the include. }}
<script src="/static/page-view.js?v={{assetVersion}}"></script>
{{! Flags images that fail to load so they show as a placeholder instead of disappearing into the text. }}
<script src="/static/broken-images.js?v={{assetVersion}}"></script>
{{>partials/mermaid-js.hbs}}
<script src="/static/vendor/highlight/highlight.min.js?v={{assetVersion}}"></script>
<script src="/static/vendor/highlight/groovy.min.js?v={{assetVersion}}"></script>
<script>if (window.hljs) hljs.highlightAll();</script>
<script src="/static/code-copy.js?v={{assetVersion}}"></script>
{{{bodyHtml}}}</body>
</html>
