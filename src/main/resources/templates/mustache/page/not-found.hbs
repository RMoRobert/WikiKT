<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found | {{siteName}}</title>
    <meta name="robots" content="noindex">
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/header.hbs}}
<div class="container wiki-layout">
{{>partials/sidebar.hbs}}
    <main class="wiki-main page-view">
        <article class="wiki-content">
            <header>
                <h1><i class="mdi mdi-file-document-alert-outline" aria-hidden="true"></i> Page does not exist</h1>
            </header>
            <p>There’s no page at <code>{{locale}}/{{pagePath}}</code>.</p>
            {{#canCreate}}
            <p>Would you like to create it now?</p>
            <p class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="{{editUrl}}"><i class="mdi mdi-file-plus-outline" aria-hidden="true"></i> Create This Page</a>
                <a class="btn btn-outline-secondary" href="/"><i class="mdi mdi-home" aria-hidden="true"></i> Go to Home</a>
            </p>
            {{/canCreate}}
            {{^canCreate}}
                <p>If you are looking for something, use the <b>Search</b> feature above or go to the home page to browse.</p>
            <p><a class="btn btn-outline-secondary" href="/"><i class="mdi mdi-home" aria-hidden="true"></i> Go to Home</a></p>
            {{/canCreate}}
        </article>
    </main>
</div>
{{>partials/footer.hbs}}
{{{bodyHtml}}}</body>
</html>
