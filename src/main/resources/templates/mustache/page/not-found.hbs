<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page not found | {{siteName}}</title>
    <meta name="robots" content="noindex">
    {{>partials/head-deps.hbs}}
    {{>partials/head-styles.hbs}}
</head>
<body>
{{>partials/header.hbs}}
<div class="container wiki-layout">
{{>partials/sidebar.hbs}}
    <main class="wiki-main page-view">
        <article class="wiki-content">
            <header>
                <h1><i class="mdi mdi-map-marker-question-outline" aria-hidden="true"></i> Page not found</h1>
            </header>
            <p>There’s no page at <code>{{locale}}/{{pagePath}}</code>.</p>
            {{#canCreate}}
            <p>You can create it now, or check the address for a typo.</p>
            <p class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="{{editUrl}}"><i class="mdi mdi-file-plus-outline" aria-hidden="true"></i> Create this page</a>
                <a class="btn btn-outline-secondary" href="/"><i class="mdi mdi-home" aria-hidden="true"></i> Back to home</a>
            </p>
            {{/canCreate}}
            {{^canCreate}}
            <p>Check the address for a typo, use search above, or head back home.</p>
            <p><a class="btn btn-outline-secondary" href="/"><i class="mdi mdi-home" aria-hidden="true"></i> Back to home</a></p>
            {{/canCreate}}
        </article>
    </main>
</div>
{{>partials/footer.hbs}}
{{{bodyHtml}}}</body>
</html>
